---
import { ArrowUpRight } from "@lucide/astro";
import type { ServiceCardData } from "../data/services";
import { siteSettings } from "../data/site-settings";

type Props = ServiceCardData;
const { num, slug, title, copy, tags, image } = Astro.props;
---

<article class="service-card">
  <div class="service-card__image">
    <img src={image} alt="" loading="lazy" />
    <span>{num}</span>
  </div>
  <div class="service-card__content">
    <h3>{title}</h3>
    <p>{copy}</p>
    <ul>{tags.map((tag) => <li>{tag}</li>)}</ul>
    <a href={`/services/${slug}/`} aria-label={`${siteSettings.nav.learnMore}: ${title}`}>{siteSettings.nav.learnMore} <ArrowUpRight aria-hidden="true" /></a>
  </div>
</article>

<style>
  .service-card { min-height:510px; display:flex; flex-direction:column; overflow:hidden; background:white; border:1px solid var(--color-line,rgba(19,42,55,.15)); border-radius:12px; transition:.3s ease; }
  .service-card:hover { position:relative; z-index:2; transform:translateY(-6px); box-shadow:var(--shadow,0 18px 50px rgba(7,31,43,.13)); }
  .service-card__image { position:relative; height:160px; flex:0 0 160px; overflow:hidden; background:var(--color-sand,#e8ded0); }
  .service-card__image img { width:100%; height:100%; display:block; object-fit:cover; transition:transform .6s ease; }
  .service-card:hover .service-card__image img { transform:scale(1.035); }
  .service-card__image span { position:absolute; top:1rem; left:1rem; min-width:2rem; padding:.3rem .5rem; color:white; background:rgba(7,31,43,.78); font-size:.65rem; text-align:center; letter-spacing:.08em; backdrop-filter:blur(5px); }
  .service-card__content { padding:1.7rem 2.1rem 2rem; display:flex; flex:1; flex-direction:column; }
  h3 { margin:0 0 1rem; font-size:1.55rem; letter-spacing:-.03em; font-weight:600; }
  p { color:#65757c; font-size:.9rem; }
  ul { margin:.2rem 0 1.5rem; padding:0; display:flex; flex-wrap:wrap; gap:.5rem; list-style:none; }
  li { padding:.25rem .55rem; color:#607079; background:var(--color-cream,#f9f5ef); font-size:.66rem; }
  a { margin-top:auto; padding-top:1rem; display:flex; justify-content:space-between; color:inherit; border-top:1px solid var(--color-line,rgba(19,42,55,.15)); font-size:.68rem; text-decoration:none; text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
  a svg { width:1rem; height:1rem; }
  @media (max-width:760px) {
    .service-card { min-height:480px; }
    .service-card__image { height:150px; flex-basis:150px; }
    .service-card__content { padding:1.5rem; }
  }
</style>
