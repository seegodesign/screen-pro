---
import { MessageSquareText } from "@lucide/astro";
import { serviceMeta } from "../data/service-meta";
import { serviceAreaRegions } from "../data/service-areas";
import { siteSettings } from "../data/site-settings";

interface Props {
  currentService?: string;
  currentArea?: string;
  quoteHref?: string;
}

const { currentService, currentArea, quoteHref = "/free-quote/" } = Astro.props;
---

<div class="site-topbar">
  <div class="site-header__container site-topbar__inner">
    <p>{siteSettings.tagline}</p>
    <div>
      <span>{siteSettings.serviceAreaLabel}</span><a href={`tel:${siteSettings.phoneNumber}`}
        >{siteSettings.phoneDisplay}</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="site-header__container site-header__inner">
    <a
      class="site-header__logo"
      href="/"
      aria-label={`${siteSettings.businessName} home`}
    >
      <img
        src="/images/logo.webp"
        width="400"
        height="154"
        alt={siteSettings.businessName}
      />
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <div class="site-header__menu">
        <button type="button" aria-haspopup="true">Services</button>
        <div class="site-header__dropdown">
          <a href="/services/">All services</a>
          {
            Object.entries(serviceMeta).map(([slug, service]) => (
              <a
                href={`/services/${slug}/`}
                aria-current={slug === currentService ? "page" : undefined}
              >
                {service.title}
              </a>
            ))
          }
        </div>
      </div>
      <a href="/about/">About</a><a href="/partners/">Partners</a><a
        href="/gallery/">Gallery</a
      ><a
        href="/reviews/">Reviews</a
      >
      <div class="site-header__menu">
        <button type="button" aria-haspopup="true">Service areas</button>
        <div class="site-header__dropdown">
          {
            Object.entries(serviceAreaRegions).map(([slug, area]) => (
              <a
                href={`/service-areas/${slug}/`}
                aria-current={slug === currentArea ? "page" : undefined}
              >
                {area.name}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
    <a class="site-header__cta" href={quoteHref}
      >Free quote <MessageSquareText aria-hidden="true" /></a
    >
    <button
      class="site-header__menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"><span></span><span></span><span></span></button
    >
  </div>
  <nav class="site-header__mobile-nav" aria-label="Mobile navigation">
    <strong>Services</strong>
    <a href="/services/">All services</a>
    {
      Object.entries(serviceMeta).map(([slug, service]) => (
        <a
          href={`/services/${slug}/`}
          aria-current={slug === currentService ? "page" : undefined}
        >
          {service.title}
        </a>
      ))
    }
    <strong>Service areas</strong>
    {
      Object.entries(serviceAreaRegions).map(([slug, area]) => (
        <a
          href={`/service-areas/${slug}/`}
          aria-current={slug === currentArea ? "page" : undefined}
        >
          {area.name}
        </a>
      ))
    }
    <a href="/about/">About</a>
    <a href="/partners/">Partners</a>
    <a href="/gallery/">Gallery</a>
    <a href="/reviews/">Reviews</a>
    <a href={quoteHref}>Free quote</a>
  </nav>
</header>

<script is:inline data-astro-rerun>
  document.querySelectorAll(".site-header").forEach((header) => {
    const button = header.querySelector(".site-header__menu-button");
    const mobileNav = header.querySelector(".site-header__mobile-nav");

    const setMenuOpen = (open) => {
      mobileNav?.classList.toggle("site-header__mobile-nav--open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.documentElement.classList.toggle("site-menu-open", open);
    };

    button?.addEventListener("click", () => {
      setMenuOpen(!mobileNav?.classList.contains("site-header__mobile-nav--open"));
    });

    mobileNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("click", (event) => {
      if (
        mobileNav?.classList.contains("site-header__mobile-nav--open") &&
        !mobileNav.contains(event.target) &&
        !button?.contains(event.target)
      ) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuOpen(false);
    });
  });
</script>

<style>
  .site-header__container {
    width: min(calc(100% - 48px), 1180px);
    margin-inline: auto;
  }
  .site-topbar {
    color: rgba(255, 255, 255, 0.84);
    background: #071f2b;
    font:
      0.7rem/1.6 "DM Sans",
      sans-serif;
    letter-spacing: 0.05em;
  }
  .site-topbar__inner {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-topbar p {
    margin: 0;
  }
  .site-topbar__inner div {
    display: flex;
    gap: 2rem;
  }
  .site-topbar a {
    color: #d4aa7d;
    font-weight: 700;
    text-decoration: none;
  }
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    background: #f9f5ef;
    font-family: "DM Sans", sans-serif;
  }
  .site-header__inner {
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .site-header__logo img {
    width: clamp(160px, 18vw, 320px);
    height: auto;
    display: block;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    color: #132a37;
    font-size: 1rem;
    font-weight: 600;
  }
  .site-header a {
    color: inherit;
    text-decoration: none;
  }
  .site-header__nav > a:hover,
  .site-header__menu button:hover {
    color: #b98552;
  }
  .site-header__menu {
    position: relative;
  }
  .site-header__menu button {
    padding: 1.25rem 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: default;
    font: inherit;
  }
  .site-header__dropdown {
    position: absolute;
    top: 100%;
    left: -1.25rem;
    width: 245px;
    display: grid;
    visibility: hidden;
    opacity: 0;
    background: #fff;
    border: 1px solid rgba(19, 42, 55, 0.15);
    box-shadow: 0 18px 50px rgba(7, 31, 43, 0.16);
    transform: translateY(-5px);
    transition: 0.2s;
  }
  .site-header__menu:hover .site-header__dropdown,
  .site-header__menu:focus-within .site-header__dropdown {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  .site-header__dropdown a {
    padding: 0.7rem 0.8rem;
  }
  .site-header__dropdown a:hover,
  .site-header__dropdown a[aria-current="page"] {
    color: #b98552;
    background: #f7f3ec;
  }
  .site-header__cta {
    min-height: 44px;
    padding: 0 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    color: #fff !important;
    background: #12324a;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .site-header__cta svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    stroke-width: 1.8;
  }
  .site-header__menu-button,
  .site-header__mobile-nav {
    display: none;
  }
  @media (max-width: 1024px) {
    :global(html.site-menu-open) {
      overflow: hidden;
    }
    .site-header::after {
      content: "";
      position: fixed;
      z-index: 21;
      inset: 76px 0 0;
      visibility: hidden;
      opacity: 0;
      background: rgba(7, 31, 43, 0.42);
      transition:
        opacity 0.3s ease,
        visibility 0s linear 0.3s;
    }
    .site-header:has(.site-header__mobile-nav--open)::after {
      visibility: visible;
      opacity: 1;
      transition-delay: 0s;
    }
    .site-header__container {
      width: min(calc(100% - 32px), 1180px);
    }
    .site-topbar,
    .site-header__nav,
    .site-header__cta {
      display: none;
    }
    .site-header__inner {
      position: relative;
      z-index: 23;
      height: 76px;
    }
    .site-header__logo img {
      width: 180px;
    }
    .site-header__menu-button {
      width: 42px;
      height: 42px;
      padding: 0 10px;
      display: grid;
      align-content: center;
      gap: 6px;
      border: 1px solid rgba(19, 42, 55, 0.15);
      background: transparent;
    }
    .site-header__menu-button span {
      height: 1px;
      background: #132a37;
    }
    .site-header__mobile-nav {
      width: min(88vw, 420px);
      height: calc(100dvh - 76px);
      padding: 1rem 16px 1.5rem;
      position: fixed;
      z-index: 22;
      inset: 76px 0 0 auto;
      display: grid;
      overflow: auto;
      grid-template-columns: 1fr;
      align-content: start;
      gap: 1px;
      visibility: hidden;
      background: #f9f5ef;
      box-shadow: 0 15px 40px rgba(7, 31, 43, 0.15);
      transform: translateX(100%);
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.35s;
    }
    .site-header__mobile-nav--open {
      visibility: visible;
      transform: translateX(0);
      transition-delay: 0s;
    }
    .site-header__mobile-nav strong,
    .site-header__mobile-nav a {
      padding: 0.8rem;
      background: #f7f3ec;
      font-size: 0.9rem;
    }
    .site-header__mobile-nav strong {
      grid-column: 1/-1;
      color: #b98552;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__mobile-nav,
    .site-header::after {
      transition-duration: 0s;
    }
  }
</style>
