---
interface Props {
  title: string;
  copy: string;
  image: string;
  icon: any;
  variant?: "feature" | "value";
}

const { title, copy, image, icon: Icon, variant = "value" } = Astro.props;
---

<article class:list={["value-card", `value-card--${variant}`]}>
  <div class="value-card__image">
    <img src={image} alt="" loading="lazy" />
  </div>
  <div class="value-card__body">
    <span><Icon size={21} strokeWidth={1.6} aria-hidden="true" /></span>
    <h3>{title}</h3>
    <p>{copy}</p>
  </div>
</article>

<style>
  .value-card {
    overflow: hidden;
    background: white;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    box-shadow: 0 12px 35px rgba(19, 42, 55, .08);
  }

  .value-card__image {
    height: 10rem;
    overflow: hidden;
  }

  .value-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .6s ease;
  }

  .value-card:hover .value-card__image img {
    transform: scale(1.035);
  }

  .value-card__body {
    padding: 0 2rem 2rem;
    text-align: center;
  }

  .value-card__body > span {
    width: 46px;
    height: 46px;
    margin: -23px auto 1.1rem;
    position: relative;
    display: grid;
    place-items: center;
    color: white;
    background: var(--color-navy);
    border: 5px solid white;
    border-radius: 50%;
  }

  .value-card--feature .value-card__body > span {
    background: var(--color-bronze);
  }

  h3 {
    margin-bottom: .6rem;
    font-size: 1.15rem;
  }

  .value-card--feature h3 {
    margin-bottom: .8rem;
    font-size: 1.35rem;
    letter-spacing: -.02em;
  }

  p {
    margin: 0;
    color: #65757c;
    font-size: .8rem;
  }

  .value-card--feature p {
    font-size: .86rem;
  }
</style>
