---
import { ArrowUpRight } from "@lucide/astro";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/free-quote.json";

const content = page.content;
---

<section class="quote" id="quote-form">
  <div class="quote__container">
    <div class="quote__content">
      <p class="quote__eyebrow">{content.eyebrow}</p>
      <h1>{content.title}<br /><em>{content.accent}</em></h1>
      <p>{content.description}</p>
      <a class="quote__phone" href={`tel:${siteSettings.phoneNumber}`}><span>{content.phoneLabel}</span><strong>{siteSettings.phoneDisplay}</strong></a>
      <a class="quote__email" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
      <div class="quote__promise"><span>✓</span><p><b>{content.promiseTitle}</b>{content.promiseCopy}</p></div>
    </div>

    <form action={`mailto:${siteSettings.email}`} method="post" enctype="text/plain">
      <div class="form__heading"><strong>{content.formTitle}</strong><span>{content.formSubtitle}</span></div>
      <div class="form__grid">
        <label><span>{content.nameLabel}</span><input type="text" name="name" placeholder={content.namePlaceholder} autocomplete="name" required /></label>
        <label><span>{content.phoneLabelField}</span><input type="tel" name="phone" placeholder={content.phonePlaceholder} autocomplete="tel" required /></label>
        <label><span>{content.emailLabel}</span><input type="email" name="email" placeholder={content.emailPlaceholder} autocomplete="email" required /></label>
        <label><span>{content.addressLabel}</span><input type="text" name="address" placeholder={content.addressPlaceholder} autocomplete="street-address" /></label>
        <label class="full"><span>{content.serviceLabel}</span>
          <select name="service" required>
            <option value="">{content.servicePlaceholder}</option>
            {content.serviceOptions.map((option) => <option>{option}</option>)}
          </select>
        </label>
        <label class="full"><span>{content.descriptionLabel}</span><textarea name="description" placeholder={content.descriptionPlaceholder} required></textarea></label>
        <label><span>{content.measurementsLabel}</span><input type="text" name="measurements" placeholder={content.measurementsPlaceholder} /></label>
      </div>
      <button type="submit">{content.submitLabel} <ArrowUpRight aria-hidden="true" /></button>
      <small>{content.consent}</small>
    </form>
  </div>
</section>

<style>
  .quote { min-height:calc(100vh - 132px); padding:7rem 0; display:flex; align-items:center; color:white; background:#0a2332; font-family:var(--font-body); }
  .quote__container { width:min(calc(100% - 48px),1180px); margin-inline:auto; display:grid; grid-template-columns:.8fr 1.2fr; gap:8%; align-items:start; }
  h1 { margin:0 0 2rem; font-size:clamp(2.7rem,4.7vw,4.7rem); font-weight:400; line-height:1; letter-spacing:-.045em; }
  h1 em { color:var(--color-bronze-light); font-weight:400; }
  .quote__eyebrow { margin-bottom:1.4rem; color:var(--color-bronze-light); font-size:.68rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
  .quote__content > p:not(.quote__eyebrow) { max-width:470px; color:rgba(255,255,255,.62); }
  .quote__phone { margin-top:2.5rem; display:grid; color:inherit; text-decoration:none; }
  .quote__phone span { color:rgba(255,255,255,.5); font-size:.65rem; letter-spacing:.15em; text-transform:uppercase; }
  .quote__phone strong { color:var(--color-bronze-light); font-family:var(--font-headline); font-size:1.7rem; font-weight:400; }
  .quote__email { margin-top:.35rem; display:block; color:rgba(255,255,255,.74); font-size:.8rem; text-decoration:none; }
  .quote__promise { margin-top:3rem; display:flex; align-items:center; gap:1rem; }
  .quote__promise > span { width:38px; height:38px; display:grid; flex:0 0 auto; place-items:center; color:var(--color-bronze-light); border:1px solid rgba(255,255,255,.25); border-radius:50%; }
  .quote__promise p { margin:0; display:grid; color:rgba(255,255,255,.5); font-size:.7rem; }
  .quote__promise b { color:white; font-size:.8rem; }
  form { padding:2.5rem; color:var(--color-ink); background:var(--color-cream); }
  .form__heading { margin-bottom:2rem; padding-bottom:1.4rem; display:flex; align-items:end; justify-content:space-between; border-bottom:1px solid var(--color-line); }
  .form__heading strong { font-family:var(--font-headline); font-size:1.5rem; font-weight:400; }
  .form__heading span { color:#6b7a81; font-size:.73rem; }
  .form__grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.2rem; }
  label { display:grid; gap:.4rem; }
  label > span { font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  input,select,textarea { width:100%; padding:.82rem 0; color:var(--color-ink); background:transparent; border:0; border-bottom:1px solid rgba(19,42,55,.25); border-radius:0; outline:0; font:inherit; }
  input:focus,select:focus,textarea:focus { border-color:var(--color-bronze); }
  textarea { min-height:90px; resize:vertical; }
  .full { grid-column:1/-1; }
  .upload { position:relative; }
  .upload input { position:absolute; opacity:0; pointer-events:none; }
  .upload i { padding:.84rem 0; color:#6b7a81; border-bottom:1px solid rgba(19,42,55,.25); font-style:normal; }
  button { width:100%; min-height:54px; margin-top:1.8rem; padding:0 1.5rem; display:flex; align-items:center; justify-content:center; gap:1.5rem; color:white; background:var(--color-bronze); border:0; cursor:pointer; font:700 .72rem var(--font-body); letter-spacing:.1em; text-transform:uppercase; }
  button svg { width:1rem; height:1rem; }
  form > small { margin-top:.8rem; display:block; color:#7a878d; text-align:center; font-size:.62rem; }
  @media (max-width:760px) {
    .quote { min-height:0; padding:4.5rem 0; }
    .quote__container { width:min(calc(100% - 32px),1180px); grid-template-columns:1fr; gap:3rem; }
    form { padding:1.5rem; }
    .form__heading { align-items:start; flex-direction:column; }
    .form__grid { grid-template-columns:1fr; }
    .full { grid-column:auto; }
  }
</style>
