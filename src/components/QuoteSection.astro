---
import { ArrowUpRight, CircleCheck } from "@lucide/astro";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/free-quote.json";

const content = page.content;
---

<section class="quote" id="quote-form">
  <div class="quote__container">
    <div class="quote__content">
      <p class="quote__eyebrow">{content.eyebrow}</p>
      <h1>{content.title}<br /><em>{content.accent}</em></h1>
      <p>{content.description}</p>
      <a class="quote__phone" href={`tel:${siteSettings.phoneNumber}`}
        ><span>{content.phoneLabel}</span><strong
          >{siteSettings.phoneDisplay}</strong
        ></a
      >
      <a class="quote__email" href={`mailto:${siteSettings.email}`}
        >{siteSettings.email}</a
      >
      <div class="quote__promise">
        <span>✓</span><p><b>{content.promiseTitle}</b>{content.promiseCopy}</p>
      </div>
    </div>

    <form action="https://submit-form.com/YZDxl4NqJ" method="post">
      <div data-form-content>
        <div class="form__heading">
          <strong>{content.formTitle}</strong><span>{content.formSubtitle}</span>
        </div>
        <div class="form__grid">
        <label
          ><span>{content.nameLabel}</span><input
            type="text"
            name="name"
            placeholder={content.namePlaceholder}
            autocomplete="name"
            required
          /></label
        >
        <label
          ><span>{content.phoneLabelField}</span><input
            type="tel"
            name="phone"
            placeholder={content.phonePlaceholder}
            autocomplete="tel"
            required
          /></label
        >
        <label
          ><span>{content.emailLabel}</span><input
            type="email"
            name="email"
            placeholder={content.emailPlaceholder}
            autocomplete="email"
            required
          /></label
        >
        <label
          ><span>{content.addressLabel}</span><input
            type="text"
            name="address"
            placeholder={content.addressPlaceholder}
            autocomplete="street-address"
          /></label
        >
        <label class="full"
          ><span>{content.serviceLabel}</span>
          <select name="service" required>
            <option value="">{content.servicePlaceholder}</option>
            {content.serviceOptions.map((option) => <option>{option}</option>)}
          </select>
        </label>
        <label class="full"
          ><span>{content.descriptionLabel}</span><textarea
            name="description"
            placeholder={content.descriptionPlaceholder}
            required></textarea></label
        >
        <label
          ><span>{content.measurementsLabel}</span><input
            type="text"
            name="measurements"
            placeholder={content.measurementsPlaceholder}
          /></label
        >
        </div>
        <button type="submit"
          >{content.submitLabel} <ArrowUpRight aria-hidden="true" /></button
        >
        <p class="form__status" data-form-status hidden aria-live="polite"></p>
        <small>{content.consent}</small>
      </div>
      <div class="form__success" data-form-success hidden tabindex="-1">
        <CircleCheck aria-hidden="true" />
        <strong>Thank you!</strong>
        <p>We received your quote request and will follow up soon.</p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("#quote-form form");

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector("[data-form-status]");
    const button = form.querySelector("button");
    const content = form.querySelector("[data-form-content]");
    const success = form.querySelector("[data-form-success]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (
        !(status instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement) ||
        !(content instanceof HTMLElement) ||
        !(success instanceof HTMLElement)
      ) {
        return;
      }

      status.hidden = true;
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        form.reset();
        content.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        status.dataset.state = "error";
        status.textContent = "Something went wrong. Please try again.";
        status.hidden = false;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .quote {
    min-height: calc(100vh - 132px);
    padding: 7rem 0;
    display: flex;
    align-items: center;
    color: white;
    background: #0a2332;
    font-family: var(--font-body);
  }
  .quote__container {
    width: min(calc(100% - 48px), 1180px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 8%;
    align-items: start;
  }
  h1 {
    margin: 0 0 2rem;
    font-size: clamp(2.7rem, 4.7vw, 4.7rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  h1 em {
    color: var(--color-bronze-light);
    font-weight: 400;
  }
  .quote__eyebrow {
    margin-bottom: 1.4rem;
    color: var(--color-bronze-light);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .quote__content > p:not(.quote__eyebrow) {
    max-width: 470px;
    color: rgba(255, 255, 255, 0.62);
  }
  .quote__phone {
    margin-top: 2.5rem;
    display: grid;
    color: inherit;
    text-decoration: none;
  }
  .quote__phone span {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .quote__phone strong {
    color: var(--color-bronze-light);
    font-family: var(--font-headline);
    font-size: 1.7rem;
    font-weight: 400;
  }
  .quote__email {
    margin-top: 0.35rem;
    display: block;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .quote__promise {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .quote__promise > span {
    width: 38px;
    height: 38px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-bronze-light);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
  }
  .quote__promise p {
    margin: 0;
    display: grid;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.7rem;
  }
  .quote__promise b {
    color: white;
    font-size: 0.8rem;
  }
  form {
    padding: 2.5rem;
    color: var(--color-ink);
    background: var(--color-cream);
  }
  .form__heading {
    margin-bottom: 2rem;
    padding-bottom: 1.4rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
  }
  .form__heading strong {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    font-weight: 400;
  }
  .form__heading span {
    color: #6b7a81;
    font-size: 0.73rem;
  }
  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label > span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.82rem 0;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(19, 42, 55, 0.25);
    border-radius: 0;
    outline: 0;
    font: inherit;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-bronze);
  }
  textarea {
    min-height: 90px;
    resize: vertical;
  }
  .full {
    grid-column: 1/-1;
  }
  .upload {
    position: relative;
  }
  .upload input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .upload i {
    padding: 0.84rem 0;
    color: #6b7a81;
    border-bottom: 1px solid rgba(19, 42, 55, 0.25);
    font-style: normal;
  }
  button {
    width: 100%;
    min-height: 54px;
    margin-top: 1.8rem;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    color: white;
    background: var(--color-bronze);
    border: 0;
    cursor: pointer;
    font: 700 0.72rem var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  button svg {
    width: 1rem;
    height: 1rem;
  }
  [data-form-content] > small {
    margin-top: 0.8rem;
    display: block;
    color: #7a878d;
    text-align: center;
    font-size: 0.62rem;
  }
  .form__status {
    margin: 0.8rem 0 0;
    color: #4b5d65;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .form__status[data-state="error"] {
    color: #a24a39;
  }
  .form__success {
    min-height: 420px;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
  }
  .form__success[hidden] {
    display: none;
  }
  .form__success svg {
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.25rem;
    color: var(--color-bronze);
  }
  .form__success strong {
    font-family: var(--font-headline);
    font-size: 2rem;
    font-weight: 400;
  }
  .form__success p {
    max-width: 330px;
    margin: 0.5rem 0 0;
    color: #6b7a81;
  }
  @media (max-width: 760px) {
    .quote {
      min-height: 0;
      padding: 4.5rem 0;
    }
    .quote__container {
      width: min(calc(100% - 32px), 1180px);
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    form {
      padding: 1.5rem;
    }
    .form__heading {
      align-items: start;
      flex-direction: column;
    }
    .form__grid {
      grid-template-columns: 1fr;
    }
    .full {
      grid-column: auto;
    }
  }
</style>
