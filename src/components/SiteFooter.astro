---
const phone = "(808) 651-8664";
const tel = "+18086518664";
---

<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__middle">
      <div>
        <span>Explore</span>
        <a href="/services/">Services</a>
        <a href="/partners/">Partners</a>
        <a href="/about/">About</a>
        <a href="/gallery/">Gallery</a>
        <a href="/reviews/">Reviews</a>
        <a href="/contact/">Contact</a>
      </div>
      <div>
        <span>Services</span>
        <a href="/services/screen-doors/">Retractable screens</a>
        <a href="/services/motorized-screens/">Motorized screens</a>
        <a href="/services/screen-repair/">Screen repair</a>
        <a href="/services/hurricane-screens/">Hurricane screens</a>
      </div>
      <div>
        <span>Service areas</span>
        <a href="/service-areas/north-shore-kauai/">North Shore Kauaʻi</a>
        <a href="/service-areas/east-side-kauai/">East Side Kauaʻi</a>
        <a href="/service-areas/south-shore-kauai/">South Shore Kauaʻi</a>
      </div>
      <div>
        <span>Contact</span>
        <a href={`tel:${tel}`}>{phone}</a>
      </div>
      <a class="site-footer__logo" href="/" aria-label="Screen Pro home">
        <img
          src="/images/logo-light.webp"
          width="1723"
          height="522"
          alt="Screen Pro Retractable Doors"
        />
      </a>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} Screen Pro Retractable Doors</span>
      <span>Family owned · Serving Kauaʻi since 1998</span>
      <a
        href="https://seegodesign.com"
        target="_blank"
        rel="noopener noreferrer">Site by Seego Design</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 5rem 0 2rem;
    color: rgba(255, 255, 255, 0.64);
    background: #071f2b;
    font-family: "DM Sans", sans-serif;
  }
  .site-footer__container {
    width: min(calc(100% - 48px), 1180px);
    margin-inline: auto;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    text-align: right;
  }
  .site-footer__logo img {
    width: 220px;
    height: auto;
    display: block;
  }
  .site-footer__logo {
    justify-self: end;
  }
  .site-footer__middle {
    padding-bottom: 3rem;
    display: grid;
    grid-template-columns: 0.8fr repeat(3, 1fr) 2fr;
    gap: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .site-footer__middle > div {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .site-footer__middle div > span {
    margin-bottom: 0.45rem;
    color: #d4aa7d;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-footer__middle a {
    width: max-content;
    max-width: 100%;
    font-size: 0.8rem;
  }
  .site-footer__middle a:hover,
  .site-footer__bottom a:hover {
    color: #d4aa7d;
  }
  .site-footer__bottom {
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    font-size: 0.66rem;
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-top: 4rem;
    }
    .site-footer__container {
      width: min(calc(100% - 32px), 1180px);
    }
    .site-footer__middle {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
    .site-footer__logo {
      display: none;
    }
    .site-footer__bottom {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
