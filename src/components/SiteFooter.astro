---
import { siteSettings } from "../data/site-settings";
import { serviceMeta } from "../data/service-meta";
import { serviceAreaRegions } from "../data/service-areas";
---

<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__middle">
      <div>
        <span>{siteSettings.footer.exploreHeading}</span>
        <a href="/services/">{siteSettings.nav.services}</a>
        <a href="/partners/">{siteSettings.nav.partners}</a>
        <a href="/about/">{siteSettings.nav.about}</a>
        <a href="/gallery/">{siteSettings.nav.gallery}</a>
        <a href="/reviews/">{siteSettings.nav.reviews}</a>
        <a href="/contact/">{siteSettings.footer.contactHeading}</a>
      </div>
      <div>
        <span>{siteSettings.footer.servicesHeading}</span>
        {Object.entries(serviceMeta).slice(0, 4).map(([slug, service]) => <a href={`/services/${slug}/`}>{service.title}</a>)}
      </div>
      <div>
        <span>{siteSettings.footer.serviceAreasHeading}</span>
        {Object.entries(serviceAreaRegions).map(([slug, area]) => <a href={`/service-areas/${slug}/`}>{area.name}</a>)}
      </div>
      <div>
        <span>{siteSettings.footer.contactHeading}</span>
        <a href={`tel:${siteSettings.phoneNumber}`}>{siteSettings.phoneDisplay}</a>
      </div>
      <a class="site-footer__logo" href="/" aria-label={`${siteSettings.businessName} home`}>
        <img
          src="/images/logo-light.webp"
          width="1723"
          height="522"
          alt={siteSettings.businessName}
        />
      </a>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} {siteSettings.businessName}</span>
      <span>{siteSettings.footer.familyOwnedPrefix} {siteSettings.foundingYear}</span>
      <a
        href={siteSettings.footer.siteByUrl}
        target="_blank"
        rel="noopener noreferrer">{siteSettings.footer.siteByLabel} {siteSettings.footer.siteByName}</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 5rem 0 2rem;
    color: rgba(255, 255, 255, 0.64);
    background: #071f2b;
    font-family: "DM Sans", sans-serif;
  }
  .site-footer__container {
    width: min(calc(100% - 48px), 1180px);
    margin-inline: auto;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    text-align: right;
  }
  .site-footer__logo img {
    width: 220px;
    height: auto;
    display: block;
  }
  .site-footer__logo {
    justify-self: end;
  }
  .site-footer__middle {
    padding-bottom: 3rem;
    display: grid;
    grid-template-columns: 0.8fr repeat(3, 1fr) 2fr;
    gap: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .site-footer__middle > div {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .site-footer__middle div > span {
    margin-bottom: 0.45rem;
    color: #d4aa7d;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-footer__middle a {
    width: max-content;
    max-width: 100%;
    font-size: 0.8rem;
  }
  .site-footer__middle a:hover,
  .site-footer__bottom a:hover {
    color: #d4aa7d;
  }
  .site-footer__bottom {
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    font-size: 0.66rem;
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-top: 4rem;
    }
    .site-footer__container {
      width: min(calc(100% - 32px), 1180px);
    }
    .site-footer__middle {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
    .site-footer__logo {
      display: none;
    }
    .site-footer__bottom {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
