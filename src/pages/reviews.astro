---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowRight, BadgeCheck, HeartHandshake, MessagesSquare } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import page from "../data/pages/reviews.json";
import { reviews } from "../data/cms";
import "../styles/variables.css";
import "../styles/reviews.css";

const icons = { messages: MessagesSquare, badge: BadgeCheck, heart: HeartHandshake };
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" type="image/png" href="/images/logomark.png" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="reviews-hero">
        <div class="container reviews-hero__grid">
          <div>
            <p class="eyebrow">{page.hero.eyebrow}</p>
            <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          </div>
          <div class="reviews-rating">
            <strong>{page.hero.rating}</strong>
            <span><b aria-label="5 out of 5 stars">★★★★★</b><small>{page.hero.ratingLabel}</small></span>
          </div>
        </div>
      </section>

      <section class="reviews-page section">
        <div class="container">
          <div class="reviews-page__intro">
            <div><p class="eyebrow eyebrow--dark">{page.intro.eyebrow}</p><h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2></div>
            <p>{page.intro.description}</p>
          </div>
          <div class="reviews-page__grid">
            {reviews.map((review) => (
              <blockquote class="review">
                <div class="review__stars" aria-hidden="true">★★★★★</div>
                <p>“{review.quote}”</p>
                <footer>
                  <span>{review.name.slice(0, 1)}</span>
                  <div><strong>{review.name}</strong><small>{review.place}, Kauaʻi · {review.service}</small></div>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <section class="review-values section">
        <div class="container">
          <div class="review-values__head"><p class="eyebrow eyebrow--dark">{page.valuesSection.eyebrow}</p><h2>{page.valuesSection.title}<br /><em>{page.valuesSection.accent}</em></h2></div>
          <div class="review-values__grid">
            {page.values.map(({ icon, title, copy }) => {
              const Icon = icons[icon as keyof typeof icons];
              return <article><Icon aria-hidden="true" /><h3>{title}</h3><p>{copy}</p></article>;
            })}
          </div>
        </div>
      </section>

      <section class="reviews-cta">
        <div class="container reviews-cta__inner">
          <div><p class="eyebrow">{page.cta.eyebrow}</p><h2>{page.cta.title}<br /><em>{page.cta.accent}</em></h2></div>
          <a href={page.cta.url}>{page.cta.label} <ArrowRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
