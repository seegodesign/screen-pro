---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, BadgeCheck } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import page from "../data/pages/partners.json";
import { partners } from "../data/cms";
import "../styles/variables.css";
import "../styles/partners.css";

const pagePartners = partners.filter((partner) => partner.name !== "Hurricane Fabric");
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" href="/favicon.svg" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">{page.hero.eyebrow}</p>
            <h1>{page.hero.title} <em>{page.hero.accent}</em></h1>
          </div>
          <p>{page.hero.description}</p>
        </div>
      </section>

      <section class="partners">
        <div class="container">
          <div class="intro">
            <div>
              <p class="eyebrow eyebrow--dark">{page.intro.eyebrow}</p>
              <h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2>
            </div>
            <p>{page.intro.description}</p>
          </div>

          <div class="partner-list">
            {pagePartners.map((partner, index) => (
              <article class="partner-card">
                <div class="partner-card__brand">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" />
                  <small>{partner.label}</small>
                </div>
                <div class="partner-card__content">
                  <p class="partner-card__verified"><BadgeCheck aria-hidden="true" /> {page.partnerBadge}</p>
                  <h2>{partner.name}</h2>
                  <p class="partner-card__intro">{partner.intro}</p>
                  <ul>{partner.points.map((point) => <li>{point}</li>)}</ul>
                  <a href={partner.url} target="_blank" rel="noopener noreferrer">
                    {page.manufacturerLinkLabel} <ArrowUpRight aria-hidden="true" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">{page.cta.eyebrow}</p><h2>{page.cta.title}<br /><em>{page.cta.accent}</em></h2></div>
          <a href={page.cta.url}>{page.cta.label} <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
