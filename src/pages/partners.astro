---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, BadgeCheck } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/variables.css";
import "../styles/partners.css";

const phone = "(808) 651-8664";
const tel = "+18086518664";

const partners = [
  {
    name: "ClearView Retractable Screens",
    logo: "/images/brand-logos/clearview.png",
    url: "https://clearviewdoor.com/",
    label: "Retractable door screens",
    intro: "A refined, American-made retractable screen system designed for smooth operation and an exceptionally clean fit.",
    points: [
      "Patented Slow-Close speed-reduction system",
      "Low-profile installation sits flush with the threshold",
      "Custom finish options for surrounding doors and trim",
      "Limited lifetime warranty protection",
    ],
  },
  {
    name: "Rainier Shading",
    logo: "/images/brand-logos/rainier.avif",
    url: "https://rainiershading.com/",
    label: "Motorized power screens",
    intro: "Premium motorized screens and shades for lanais, garages, wide doors, and other expansive indoor-outdoor openings.",
    points: [
      "Built for large residential and commercial openings",
      "Remote, switch, and smart-home control options",
      "Strong construction with clean architectural housings",
      "More than 125 years of manufacturing experience",
    ],
  },
  {
    name: "Wizard Screens & Shades",
    logo: "/images/brand-logos/wizard.svg",
    url: "https://www.wizardscreens.com/",
    label: "Large-format screens and shades",
    intro: "Versatile retractable and motorized systems engineered for demanding openings where fit, seal, and appearance all matter.",
    points: [
      "Solutions for wide, tall, and open-corner applications",
      "Integrated framing options for a seamless finish",
      "Partial-opening and custom locking configurations",
      "Manual and motorized systems for doors and windows",
    ],
  },
];
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore Screen Pro’s trusted retractable and motorized screen partners: ClearView, Rainier Shading, and Wizard Screens & Shades." />
    <link rel="icon" href="/favicon.svg" />
    <title>Our Screen Partners | Screen Pro Kauaʻi</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">Trusted manufacturers</p>
            <h1>Better screens begin with <em>better partners.</em></h1>
          </div>
          <p>We choose manufacturers for product quality, thoughtful engineering, long-term serviceability, and dependable support, not simply for the widest catalog.</p>
        </div>
      </section>

      <section class="partners">
        <div class="container">
          <div class="intro">
            <div>
              <p class="eyebrow eyebrow--dark">Authorized systems</p>
              <h2>Products we trust.<br /><em>Support that stays local.</em></h2>
            </div>
            <p>As Kauaʻi’s exclusive dealer for ClearView, Rainier, and Wizard, we help you compare systems, specify the right product, manage ordering, and provide professional installation and ongoing service.</p>
          </div>

          <div class="partner-list">
            {partners.map((partner, index) => (
              <article class="partner-card">
                <div class="partner-card__brand">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" />
                  <small>{partner.label}</small>
                </div>
                <div class="partner-card__content">
                  <p class="partner-card__verified"><BadgeCheck aria-hidden="true" /> Screen Pro partner</p>
                  <h2>{partner.name}</h2>
                  <p class="partner-card__intro">{partner.intro}</p>
                  <ul>{partner.points.map((point) => <li>{point}</li>)}</ul>
                  <a href={partner.url} target="_blank" rel="noopener noreferrer">
                    Visit manufacturer website <ArrowUpRight aria-hidden="true" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">Not sure which system fits?</p><h2>We’ll help you compare<br /><em>the right options.</em></h2></div>
          <a href="/contact/">Start your project <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
