---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, BadgeCheck } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/variables.css";

const phone = "(808) 651-8664";
const tel = "+18086518664";

const partners = [
  {
    name: "ClearView Retractable Screens",
    logo: "/images/brand-logos/clearview.png",
    url: "https://clearviewdoor.com/",
    label: "Retractable door screens",
    intro: "A refined, American-made retractable screen system designed for smooth operation and an exceptionally clean fit.",
    points: [
      "Patented Slow-Close speed-reduction system",
      "Low-profile installation sits flush with the threshold",
      "Custom finish options for surrounding doors and trim",
      "Limited lifetime warranty protection",
    ],
  },
  {
    name: "Rainier Shading",
    logo: "/images/brand-logos/rainier.avif",
    url: "https://rainiershading.com/",
    label: "Motorized power screens",
    intro: "Premium motorized screens and shades for lanais, garages, wide doors, and other expansive indoor-outdoor openings.",
    points: [
      "Built for large residential and commercial openings",
      "Remote, switch, and smart-home control options",
      "Strong construction with clean architectural housings",
      "More than 125 years of manufacturing experience",
    ],
  },
  {
    name: "Wizard Screens & Shades",
    logo: "/images/brand-logos/wizard.svg",
    url: "https://www.wizardscreens.com/",
    label: "Large-format screens and shades",
    intro: "Versatile retractable and motorized systems engineered for demanding openings where fit, seal, and appearance all matter.",
    points: [
      "Solutions for wide, tall, and open-corner applications",
      "Integrated framing options for a seamless finish",
      "Partial-opening and custom locking configurations",
      "Manual and motorized systems for doors and windows",
    ],
  },
];
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore Screen Pro’s trusted retractable and motorized screen partners: ClearView, Rainier Shading, and Wizard Screens & Shades." />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Our Screen Partners | Screen Pro Kauaʻi</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">Trusted manufacturers</p>
            <h1>Better screens begin with <em>better partners.</em></h1>
          </div>
          <p>We choose manufacturers for product quality, thoughtful engineering, long-term serviceability, and dependable support—not simply for the widest catalog.</p>
        </div>
      </section>

      <section class="partners">
        <div class="container">
          <div class="intro">
            <div>
              <p class="eyebrow eyebrow--dark">Authorized systems</p>
              <h2>Products we trust.<br /><em>Support that stays local.</em></h2>
            </div>
            <p>As Kauaʻi’s exclusive dealer for ClearView, Rainier, and Wizard, we help you compare systems, specify the right product, manage ordering, and provide professional installation and ongoing service.</p>
          </div>

          <div class="partner-list">
            {partners.map((partner, index) => (
              <article class="partner-card">
                <div class="partner-card__brand">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" />
                  <small>{partner.label}</small>
                </div>
                <div class="partner-card__content">
                  <p class="partner-card__verified"><BadgeCheck aria-hidden="true" /> Screen Pro partner</p>
                  <h2>{partner.name}</h2>
                  <p class="partner-card__intro">{partner.intro}</p>
                  <ul>{partner.points.map((point) => <li>{point}</li>)}</ul>
                  <a href={partner.url} target="_blank" rel="noopener noreferrer">
                    Visit manufacturer website <ArrowUpRight aria-hidden="true" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">Not sure which system fits?</p><h2>We’ll help you compare<br /><em>the right options.</em></h2></div>
          <a href="/contact/">Start your project <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  * { box-sizing:border-box; }
  body { margin:0; color:var(--color-ink); background:var(--color-cream); font-family:var(--font-body); line-height:1.65; }
  a { color:inherit; text-decoration:none; }
  h1,h2,p { margin-top:0; }
  h1,h2 { font-family: var(--font-headline), serif; font-weight:500; letter-spacing:-.045em; }
  h1 { margin:0; font-size:clamp(3rem,5.8vw,5.5rem); line-height:.98; }
  h2 { font-size:clamp(2rem,3.6vw,3.5rem); line-height:1.03; }
  em { color:var(--color-bronze-light); font-family:var(--font-headline); font-weight:400; }
  .container { width:min(calc(100% - 48px),1180px); margin-inline:auto; }
  .eyebrow { margin-bottom:1.25rem; color:var(--color-bronze-light); font-size:.68rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
  .eyebrow--dark { color:var(--color-ocean); }
  .hero { padding:7rem 0; color:white; background:linear-gradient(100deg,rgba(7,31,43,.96),rgba(18,50,74,.72)),url("/images/kauai-luxury-motorized-screen.avif") center/cover; }
  .hero__grid { display:grid; grid-template-columns:1.35fr .65fr; gap:8%; align-items:end; }
  .hero__grid > p { max-width:440px; margin:0 0 .5rem; color:rgba(255,255,255,.7); }
  .partners { padding:7rem 0; }
  .intro { margin-bottom:4rem; display:grid; grid-template-columns:1fr 1fr; gap:8%; align-items:end; }
  .intro h2 { margin-bottom:0; }
  .intro > p { max-width:500px; margin-bottom:.5rem; color:var(--color-muted); }
  .partner-list { display:grid; gap:1.5rem; }
  .partner-card { min-height:430px; display:grid; grid-template-columns:.72fr 1.28fr; overflow:hidden; background:white; border:1px solid var(--color-line); border-radius:12px; box-shadow:0 16px 45px rgba(7,31,43,.08); }
  .partner-card__brand { padding:2.5rem; position:relative; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:1.5rem; color:white; background:var(--color-navy); }
  .partner-card__brand > span { position:absolute; top:1.5rem; left:1.5rem; color:rgba(255,255,255,.45); font-size:.65rem; letter-spacing:.1em; }
  .partner-card__brand img { width:auto; max-width:240px; height:auto; max-height:105px; object-fit:contain; }
  .partner-card__brand small { color:rgba(255,255,255,.56); font-size:.65rem; letter-spacing:.12em; text-align:center; text-transform:uppercase; }
  .partner-card__content { padding:3rem; }
  .partner-card__verified { display:flex; align-items:center; gap:.5rem; color:var(--color-bronze); font-size:.66rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .partner-card__verified svg { width:17px; }
  .partner-card__content h2 { margin-bottom:1rem; font-size:clamp(1.8rem,3vw,2.7rem); }
  .partner-card__intro { max-width:650px; color:var(--color-muted); }
  .partner-card ul { margin:1.5rem 0 2rem; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:.7rem 1.5rem; list-style:none; }
  .partner-card li { padding-left:1rem; position:relative; color:#53666f; font-size:.82rem; }
  .partner-card li::before { content:""; width:5px; height:5px; position:absolute; top:.68rem; left:0; background:var(--color-bronze); border-radius:50%; }
  .partner-card__content > a { width:max-content; padding-bottom:.3rem; display:flex; align-items:center; gap:1rem; border-bottom:1px solid var(--color-ink); font-size:.7rem; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }
  .partner-card__content > a svg { width:16px; transition:transform .2s; }
  .partner-card__content > a:hover svg { transform:translate(2px,-2px); }
  .cta { padding:6rem 0; color:white; background:var(--color-navy-deep); }
  .cta__inner { display:flex; align-items:end; justify-content:space-between; gap:3rem; }
  .cta h2 { margin:0; }
  .cta__inner > a { min-height:54px; padding:0 1.5rem; display:flex; align-items:center; gap:1.5rem; color:white; background:var(--color-bronze); font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .cta__inner > a svg { width:17px; }
  footer { padding:3rem 0; color:rgba(255,255,255,.72); background:#061a24; }
  .footer__inner { display:flex; align-items:center; gap:2rem; }
  .footer__inner img { width:170px; height:auto; }
  .footer__inner p { margin:0 auto 0 0; }
  .footer__inner nav { display:flex; gap:1.4rem; }
  .footer__inner a:hover { color:var(--color-bronze-light); }
  @media (max-width:760px) {
    .container { width:min(calc(100% - 32px),1180px); }
    .hero { padding:5rem 0; }
    .hero__grid,.intro,.partner-card { grid-template-columns:1fr; }
    .hero__grid,.intro { gap:2rem; }
    .partners { padding:4.5rem 0; }
    .partner-card__brand { min-height:210px; }
    .partner-card__brand img { max-width:210px; max-height:85px; }
    .partner-card__content { padding:2rem 1.5rem; }
    .partner-card ul { grid-template-columns:1fr; }
    .cta__inner { align-items:flex-start; flex-direction:column; }
    .footer__inner { align-items:flex-start; flex-direction:column; }
    .footer__inner p { margin:0; }
    .footer__inner nav { flex-wrap:wrap; }
  }
</style>
