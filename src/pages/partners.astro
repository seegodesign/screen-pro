---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, BadgeCheck } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/variables.css";
import "../styles/partners.css";

const partners = [
  {
    name: "ClearView Retractable Screens",
    logo: "/images/brand-logos/clearview.png",
    url: "https://clearviewdoor.com/",
    label: "Retractable door screens",
    intro: "A refined, American-made retractable screen system featuring ClearView’s exclusive hydraulically controlled Slow-Close speed reducer for a safer, smoother return into the housing.",
    points: [
      "Exclusive, proven Slow-Close speed-reduction system",
      "Controlled return helps protect small or frail hands",
      "Smooth retraction reduces mesh tearing and component abrasion",
      "Low-profile installation sits flush with the threshold",
      "Custom finish options for surrounding doors and trim",
      "Limited lifetime warranty protection",
    ],
  },
  {
    name: "Rainier Shading",
    logo: "/images/brand-logos/rainier.avif",
    url: "https://rainiershading.com/",
    label: "Motorized power screens",
    intro: "Premium power screens and shades for lanais, garages, wide doors, and other expansive indoor-outdoor openings.",
    points: [
      "Built for large residential and commercial openings",
      "Remote, switch, and app-based smart home control options",
      "Strong construction with clean architectural housings",
      "More than 125 years of manufacturing experience",
      "Made in USA",
      "Warranties Available",
    ],
  },
  {
    name: "Centor",
    logo: "/images/brand-logos/centor.svg",
    url: "https://centor.com/us/screens",
    label: "Retractable screens and shades",
    intro: "Award-winning retractable screen and shade systems designed to disappear into the frame, preserving clean sightlines while managing insects, glare, and privacy.",
    points: [
      "S2 retractable screens for smaller doors and windows",
      "S4 screen and shade systems for expansive openings",
      "Smooth, fingertip operation for everyday use",
      "Single-screen, shade, and combination configurations",
      "Light-filtering and block-out shade options",
      "Made to measure for new construction or retrofit projects",
    ],
  },
  {
    name: "Wizard Screens & Shades",
    logo: "/images/brand-logos/wizard.svg",
    url: "https://www.wizardscreens.com/",
    label: "Large-format screens and shades",
    intro: "Versatile retractable and motorized systems engineered for demanding openings, including the side-to-side Horizon wall screen with patented auto-brake control.",
    points: [
      "Solutions for wide, tall, and open-corner applications",
      "Integrated framing options for a seamless finish",
      "Patented auto-brake stops at any width",
      "Unlimited stopping points along the horizontal track",
      "Flush-mounted handle for a sleek, modern profile",
      "Manual and motorized systems for doors and windows",
    ],
  },
];
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore Screen Pro’s trusted retractable and power screen partners: ClearView, Rainier Shading, Centor, and Wizard Screens & Shades." />
    <link rel="icon" href="/favicon.svg" />
    <title>Our Screen Partners | Screen Pro Kauaʻi</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">Trusted manufacturers</p>
            <h1>Better screens begin with <em>better partners.</em></h1>
          </div>
          <p>We choose manufacturers for product quality, thoughtful engineering, long-term serviceability, and dependable support, not simply for the widest catalog.</p>
        </div>
      </section>

      <section class="partners">
        <div class="container">
          <div class="intro">
            <div>
              <p class="eyebrow eyebrow--dark">Authorized systems</p>
              <h2>Products we trust.<br /><em>Support that stays local.</em></h2>
            </div>
            <p>Through our partnerships with ClearView, Rainier, Centor, and Wizard, we help you compare systems, specify the right product, manage ordering, and provide professional installation and ongoing service.</p>
          </div>

          <div class="partner-list">
            {partners.map((partner, index) => (
              <article class="partner-card">
                <div class="partner-card__brand">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" />
                  <small>{partner.label}</small>
                </div>
                <div class="partner-card__content">
                  <p class="partner-card__verified"><BadgeCheck aria-hidden="true" /> Screen Pro partner</p>
                  <h2>{partner.name}</h2>
                  <p class="partner-card__intro">{partner.intro}</p>
                  <ul>{partner.points.map((point) => <li>{point}</li>)}</ul>
                  <a href={partner.url} target="_blank" rel="noopener noreferrer">
                    Visit manufacturer website <ArrowUpRight aria-hidden="true" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">Not sure which system fits?</p><h2>We’ll help you compare<br /><em>the right options.</em></h2></div>
          <a href="/contact/">Start your project <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
