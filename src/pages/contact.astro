---
import { ClientRouter, fade } from "astro:transitions";
import { Clock3, Mail, Phone } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/contact.json";
import "../styles/variables.css";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" href="/favicon.svg" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="contact-hero">
        <div class="container">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          <p class="lede">{page.hero.description}</p>
        </div>
      </section>

      <section class="contact-section" id="contact-form">
        <div class="container contact-grid">
          <aside>
            <p class="eyebrow eyebrow--dark">{page.intro.eyebrow}</p>
            <h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2>
            <p>{page.intro.description}</p>
            <div class="contact-methods">
              <a href={`tel:${siteSettings.phoneNumber}`}><Phone aria-hidden="true" /><span><small>{page.contactLabels.phone}</small><strong>{siteSettings.phoneDisplay}</strong></span></a>
              <a href={`mailto:${siteSettings.email}`}><Mail aria-hidden="true" /><span><small>{page.contactLabels.email}</small><strong>{siteSettings.email}</strong></span></a>
              <div><Clock3 aria-hidden="true" /><span><small>{page.contactLabels.response}</small><strong>{page.contactLabels.responseValue}</strong></span></div>
            </div>
          </aside>

          <form action={`mailto:${siteSettings.email}`} method="post" enctype="text/plain">
            <div class="form-grid">
              <label>{page.form.nameLabel}<input name="name" autocomplete="name" required /></label>
              <label>{page.form.phoneLabel}<input name="phone" type="tel" autocomplete="tel" required /></label>
              <label>{page.form.emailLabel}<input name="email" type="email" autocomplete="email" required /></label>
              <label>{page.form.townLabel}<input name="town" autocomplete="address-level2" /></label>
              <label class="full">{page.form.serviceLabel}
                <select name="service">
                  <option value="">{page.form.servicePlaceholder}</option>
                  {page.form.serviceOptions.map((option) => <option>{option}</option>)}
                </select>
              </label>
              <label class="full">{page.form.messageLabel}<textarea name="message" rows="5" required></textarea></label>
            </div>
            <button type="submit">{page.form.submitLabel}</button>
            <small class="form-note">{page.form.note}</small>
          </form>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
