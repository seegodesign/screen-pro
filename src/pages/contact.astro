---
import { ClientRouter, fade } from "astro:transitions";
import { CircleCheck, Clock3, Mail, Phone } from "@lucide/astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/contact.json";
import "../styles/variables.css";

const TURNSTILE_SITE_KEY = "0x4AAAAAAEa7xLP7yb_HFek7";
const FORM_ID = "fm_ytpnsLborBrq3DoA";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <SeoHead
      title={page.seoTitle}
      description={page.seoDescription}
      path="/contact/"
    />
    <ClientRouter />
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer></script>
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="contact-hero">
        <div class="container">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          <p class="lede">{page.hero.description}</p>
        </div>
      </section>

      <section class="contact-section" id="contact-form">
        <div class="container contact-grid">
          <aside>
            <p class="eyebrow eyebrow--dark">{page.intro.eyebrow}</p>
            <h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2>
            <p>{page.intro.description}</p>
            <div class="contact-methods">
              <a href={`tel:${siteSettings.phoneNumber}`}
                ><Phone aria-hidden="true" /><span
                  ><small>{page.contactLabels.phone}</small><strong
                    >{siteSettings.phoneDisplay}</strong
                  ></span
                ></a
              >
              <a href={`mailto:${siteSettings.email}`}
                ><Mail aria-hidden="true" /><span
                  ><small>{page.contactLabels.email}</small><strong
                    >{siteSettings.email}</strong
                  ></span
                ></a
              >
              <div>
                <Clock3 aria-hidden="true" /><span
                  ><small>{page.contactLabels.response}</small><strong
                    >{page.contactLabels.responseValue}</strong
                  ></span
                >
              </div>
            </div>
          </aside>

          <form
            action="https://forms.seegodesign.com/f/fm_ytpnsLborBrq3DoA"
            method="post"
          >
            <div data-form-content>
              <div class="form-grid">
                <label
                  >{page.form.nameLabel}<input
                    name="name"
                    autocomplete="name"
                    required
                  /></label
                >
                <label
                  >{page.form.phoneLabel}<input
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                  /></label
                >
                <label
                  >{page.form.emailLabel}<input
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                  /></label
                >
                <label
                  >{page.form.townLabel}<input
                    name="town"
                    autocomplete="address-level2"
                  /></label
                >
                <label class="full"
                  >{page.form.serviceLabel}
                  <select name="service">
                    <option value="">{page.form.servicePlaceholder}</option>
                    {
                      page.form.serviceOptions.map((option) => (
                        <option>{option}</option>
                      ))
                    }
                  </select>
                </label>
                <label class="full"
                  >{page.form.messageLabel}<textarea
                    name="message"
                    rows="5"
                    required></textarea></label
                >
              </div>
              <input
                name="_cf_honeypot"
                tabindex={-1}
                autocomplete="off"
                aria-hidden="true"
                style="position:absolute;left:-9999px"
              />
              <div
                class="cf-turnstile"
                data-sitekey={TURNSTILE_SITE_KEY}
                data-action="form_submit"
                data-cdata={FORM_ID}
                data-response-field-name="_cf_turnstile"
              >
              </div>
              <button type="submit">{page.form.submitLabel}</button>
              <p class="form-status" data-form-status hidden aria-live="polite">
              </p>
              <small class="form-note">{page.form.note}</small>
            </div>
            <div class="form-success" data-form-success hidden tabindex="-1">
              <CircleCheck aria-hidden="true" />
              <strong>Thank you!</strong>
              <p>We received your message and will respond soon.</p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  type TurnstileApi = {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action?: string;
        cData?: string;
        "response-field-name"?: string;
      },
    ) => string;
    reset: (widgetId?: string) => void;
  };

  const turnstileWindow = window as Window & { turnstile?: TurnstileApi };

  const setupContactForm = () => {
    const form = document.querySelector("#contact-form form");

    if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") {
      return;
    }

    form.dataset.bound = "true";

    const status = form.querySelector("[data-form-status]");
    const button = form.querySelector("button");
    const content = form.querySelector("[data-form-content]");
    const success = form.querySelector("[data-form-success]");
    const widget = form.querySelector(".cf-turnstile");
    let widgetId: string | undefined;

    const renderWidget = () => {
      if (
        widgetId !== undefined ||
        !(widget instanceof HTMLElement) ||
        !turnstileWindow.turnstile
      ) {
        return;
      }

      const sitekey = widget.dataset.sitekey;
      if (!sitekey) {
        return;
      }

      widgetId = turnstileWindow.turnstile.render(widget, {
        sitekey,
        action: widget.dataset.action,
        cData: widget.dataset.cdata,
        "response-field-name": widget.dataset.responseFieldName,
      });
    };

    renderWidget();
    document
      .querySelectorAll('script[src*="challenges.cloudflare.com/turnstile"]')
      .forEach((script) => {
        script.addEventListener("load", renderWidget, { once: true });
      });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (
        !(status instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement) ||
        !(content instanceof HTMLElement) ||
        !(success instanceof HTMLElement)
      ) {
        return;
      }

      status.hidden = true;
      button.disabled = true;

      const payload = Object.fromEntries(new FormData(form));
      const token = payload._cf_turnstile;

      if (typeof token !== "string" || token.length === 0) {
        status.dataset.state = "error";
        status.textContent = "Please complete the verification challenge.";
        status.hidden = false;
        button.disabled = false;
        return;
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        form.reset();
        content.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        status.dataset.state = "error";
        status.textContent = "Something went wrong. Please try again.";
        status.hidden = false;
      } finally {
        button.disabled = false;
        if (widgetId !== undefined) {
          turnstileWindow.turnstile?.reset(widgetId);
        } else {
          turnstileWindow.turnstile?.reset();
        }
      }
    });
  };

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
