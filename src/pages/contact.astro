---
import { ClientRouter, fade } from "astro:transitions";
import { Clock3, Mail, Phone } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/variables.css";

const phone = "(808) 651-8664";
const tel = "+18086518664";
const email = "info@kauairetractablescreens.com";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Contact Screen Pro for custom screen installation and repair on Kauaʻi’s North Shore, East Side, and South Shore." />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Contact Screen Pro | Screen Services on Kauaʻi</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="contact-hero">
        <div class="container">
          <p class="eyebrow">Start a conversation</p>
          <h1>Let’s talk about<br /><em>your screen project.</em></h1>
          <p class="lede">Tell us what you need and where you’re located. We’ll follow up with helpful advice and the right next step for your Kauaʻi home or business.</p>
        </div>
      </section>

      <section class="contact-section" id="contact-form">
        <div class="container contact-grid">
          <aside>
            <p class="eyebrow eyebrow--dark">Contact Screen Pro</p>
            <h2>Local help,<br /><em>without the hard sell.</em></h2>
            <p>Questions are welcome. Reach out directly or send a few project details through the form.</p>
            <div class="contact-methods">
              <a href={`tel:${tel}`}><Phone aria-hidden="true" /><span><small>Call us</small><strong>{phone}</strong></span></a>
              <a href={`mailto:${email}`}><Mail aria-hidden="true" /><span><small>Email us</small><strong>{email}</strong></span></a>
              <div><Clock3 aria-hidden="true" /><span><small>Response time</small><strong>Usually within one business day</strong></span></div>
            </div>
          </aside>

          <form action={`mailto:${email}`} method="post" enctype="text/plain">
            <div class="form-grid">
              <label>Name *<input name="name" autocomplete="name" required /></label>
              <label>Phone *<input name="phone" type="tel" autocomplete="tel" required /></label>
              <label>Email *<input name="email" type="email" autocomplete="email" required /></label>
              <label>Town<input name="town" autocomplete="address-level2" /></label>
              <label class="full">What can we help with?
                <select name="service">
                  <option value="">Select a service</option>
                  <option>Retractable screen doors</option>
                  <option>Motorized screens</option>
                  <option>Window screens</option>
                  <option>Sliding screen doors</option>
                  <option>Hurricane screens</option>
                  <option>Screen repair</option>
                  <option>Not sure yet</option>
                </select>
              </label>
              <label class="full">Project details *<textarea name="message" rows="5" required></textarea></label>
            </div>
            <button type="submit">Send message</button>
            <small class="form-note">Submitting opens your email app with these details ready to send.</small>
          </form>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root { --navy:#12324a; --deep:#071f2b; --bronze:#b98552; --cream:#f9f5ef; --sand:#e8ded0; --ink:#132a37; --muted:#63737a; --line:rgba(19,42,55,.15); }
  * { box-sizing:border-box; }
  body { margin:0; color:var(--ink); background:var(--cream); font-family:"DM Sans",sans-serif; line-height:1.65; }
  a { color:inherit; text-decoration:none; }
  h1,h2,p { margin-top:0; }
  h1,h2 { font-weight:500; letter-spacing:-.045em; }
  h1 { max-width:760px; margin-bottom:1.5rem; font-size:clamp(3rem,6vw,5.5rem); line-height:.98; }
  h2 { margin-bottom:1.5rem; font-size:clamp(2.2rem,4vw,3.7rem); line-height:1; }
  em { color:#d4aa7d; font-family:Georgia,serif; font-weight:400; }
  .container { width:min(calc(100% - 48px),1180px); margin-inline:auto; }
  .eyebrow { margin-bottom:1.25rem; color:#d4aa7d; font-size:.7rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
  .eyebrow--dark { color:#567786; }
  .contact-hero { padding:6.5rem 0 7rem; color:white; background:linear-gradient(90deg,rgba(7,31,43,.94),rgba(18,50,74,.82)),url("/images/screen-installation-2.avif") center/cover; }
  .lede { max-width:650px; margin:0; color:rgba(255,255,255,.72); font-size:1.05rem; }
  .contact-section { padding:7rem 0; }
  .contact-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:8%; align-items:start; }
  aside > p:not(.eyebrow) { max-width:440px; color:var(--muted); }
  .contact-methods { margin-top:2.5rem; display:grid; gap:1px; background:var(--line); border:1px solid var(--line); }
  .contact-methods > * { min-height:86px; padding:1.1rem 1.25rem; display:flex; align-items:center; gap:1rem; background:white; }
  .contact-methods svg { width:21px; color:var(--bronze); }
  .contact-methods span { display:grid; }
  .contact-methods small { color:var(--muted); font-size:.66rem; letter-spacing:.1em; text-transform:uppercase; }
  .contact-methods strong { font-size:.86rem; overflow-wrap:anywhere; }
  form { padding:2.25rem; background:white; border:1px solid var(--line); box-shadow:0 18px 50px rgba(7,31,43,.1); }
  .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  label { display:grid; gap:.45rem; color:#52656e; font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  label.full { grid-column:1/-1; }
  input,select,textarea { width:100%; padding:.85rem; border:1px solid var(--line); border-radius:0; color:var(--ink); background:var(--cream); font:500 .9rem "DM Sans",sans-serif; text-transform:none; letter-spacing:0; }
  textarea { resize:vertical; }
  input:focus,select:focus,textarea:focus { outline:2px solid rgba(185,133,82,.35); border-color:var(--bronze); }
  button { min-height:52px; margin-top:1.25rem; padding:0 1.6rem; border:0; color:white; background:var(--bronze); cursor:pointer; font:700 .72rem "DM Sans",sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  button:hover { background:#a97543; }
  .form-note { display:block; margin-top:.8rem; color:var(--muted); }
  footer { padding:3rem 0; color:rgba(255,255,255,.75); background:var(--deep); }
  .footer-inner { display:flex; align-items:center; gap:2rem; }
  .footer-inner img { width:170px; height:auto; }
  .footer-inner p { margin:0 auto 0 0; }
  .footer-inner nav { display:flex; gap:1.5rem; }
  .footer-inner a:hover { color:#d4aa7d; }
  @media (max-width:760px) {
    .container { width:min(calc(100% - 32px),1180px); }
    .contact-hero { padding:4.5rem 0 5rem; }
    .contact-section { padding:4.5rem 0; }
    .contact-grid,.form-grid { grid-template-columns:1fr; }
    .contact-grid { gap:3rem; }
    label.full { grid-column:auto; }
    form { padding:1.5rem; }
    .footer-inner { align-items:flex-start; flex-direction:column; }
    .footer-inner p { margin:0; }
  }
</style>
