---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, Phone } from "@lucide/astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { serviceMeta, type ServiceSlug } from "../../data/service-meta";
import serviceContent from "../../data/service-content.json";
import { serviceAreas } from "../../data/service-areas";
import { siteSettings } from "../../data/site-settings";
import "../../styles/variables.css";
import "../../styles/service-detail.css";

type Benefit = { title: string; body: string };
type ProcessStep = Benefit & { step: string };
type Faq = { q: string; a: string };
type PowerScreenSeries = {
  name: string;
  idealFor: string;
  maxWidth: string;
  maxDrop: string;
  summary: string;
};

export function getStaticPaths() {
  return Object.keys(serviceMeta).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as ServiceSlug;
const meta = serviceMeta[slug];
if (!meta) return Astro.redirect("/#services");

const content = serviceContent[slug];
const heroImage = content.heroImage;
const intro = content.intro;
const benefits = content.benefits as Benefit[];
const process = content.process as ProcessStep[];
const series = ("series" in content ? content.series : []) as PowerScreenSeries[];
const faqs = content.faqs as Faq[];
const relatedSlugs = content.relatedSlugs as ServiceSlug[];
const related = relatedSlugs.map((relatedSlug) => ({ slug: relatedSlug, ...serviceMeta[relatedSlug] }));

const siteUrl = siteSettings.siteUrl;
const pageUrl = `${siteUrl}/services/${slug}/`;
const seoDescription = `${intro} Professional service and installation across Kauaʻi’s North, East, and South sides.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: meta.title,
      serviceType: meta.title,
      description: intro,
      url: pageUrl,
      image: heroImage,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Kauaʻi, Hawaii" },
        ...serviceAreas.map((town) => ({ "@type": "City", name: `${town}, Hawaii` })),
      ],
      provider: { "@id": `${siteUrl}/#business` },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: { "@type": "Answer", text: faq.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seoDescription} />
    <meta name="theme-color" content="#12324a" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{meta.heroKeyword} | {siteSettings.businessName}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader currentService={slug} quoteHref="/free-quote/" />

    <main>
      <section class="hero" style={`--hero-image: url("${heroImage}")`}>
        <div class="container hero__inner">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>{meta.title}</span></nav>
          <p class="eyebrow">Screen Pro Kauaʻi</p>
          <h1>{meta.heroKeyword}</h1>
          <p class="hero__lede">{intro}</p>
          <div class="hero__actions">
            <a class="button button--bronze" href="/free-quote/">Get a free quote <span class="button__arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></span></a>
            <a class="button button--glass" href={`tel:${siteSettings.phoneNumber}`}>Call {siteSettings.phoneDisplay} <Phone aria-hidden="true" /></a>
          </div>
        </div>
      </section>

      <section class="section overview">
        <div class="container overview__grid">
          <div>
            <p class="eyebrow eyebrow--dark">What’s included</p>
            <h2>{meta.title} on Kauaʻi,<br /><em>done right.</em></h2>
            <p class="lead">{meta.description}</p>
            <ul class="check-list">{meta.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}</ul>
            <a class="button button--dark" href={`tel:${siteSettings.phoneNumber}`}>Call for a free estimate <Phone aria-hidden="true" /></a>
          </div>
          <div>
            <p class="eyebrow eyebrow--dark">Why it matters</p>
            <div class="benefit-list">
              {benefits.map((benefit, index) => (
                <article><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{benefit.title}</h3><p>{benefit.body}</p></div></article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section process">
        <div class="container">
          <div class="section-head"><p class="eyebrow eyebrow--dark">How it works</p><h2>Our process,<br /><em>from quote to completion.</em></h2></div>
          <div class="process__grid">
            {process.map((item) => <article><strong>{item.step.padStart(2, "0")}</strong><h3>{item.title}</h3><p>{item.body}</p></article>)}
          </div>
        </div>
      </section>

      {series.length > 0 && (
        <section class="section series-guide">
          <div class="container">
            <div class="series-guide__head">
              <div><p class="eyebrow eyebrow--dark">Power screen sizing</p><h2>Which series fits<br /><em>your opening?</em></h2></div>
              <p>Rainier power screen series are sized for different spans and drops. We measure the opening and confirm the right housing, fabric, and mounting configuration.</p>
            </div>
            <div class="series-guide__grid">
              {series.map((item, index) => (
                <article>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <p>{item.idealFor}</p>
                  <h3>{item.name} Power Screen</h3>
                  <div class="series-guide__dimensions">
                    <div><small>Up to</small><strong>{item.maxWidth}</strong><small>wide</small></div>
                    <div><small>Up to</small><strong>{item.maxDrop}</strong><small>high</small></div>
                  </div>
                  <p>{item.summary}</p>
                </article>
              ))}
            </div>
            <small class="series-guide__note">Maximum dimensions vary by fabric, mounting method, and site conditions. Final sizing is confirmed during consultation.</small>
          </div>
        </section>
      )}

      <section class="section faq">
        <div class="container faq__grid">
          <div><p class="eyebrow eyebrow--dark">FAQ</p><h2>Common<br /><em>questions.</em></h2></div>
          <FaqAccordion items={faqs} />
        </div>
      </section>

      <section class="section related">
        <div class="container">
          <div class="section-head"><p class="eyebrow eyebrow--dark">More services</p><h2>Explore other<br /><em>screen solutions.</em></h2></div>
          <div class="related__grid">
            {related.map((item) => <a href={`/services/${item.slug}/`}><h3>{item.title}</h3><p>{item.description}</p><span>Learn more <ArrowUpRight aria-hidden="true" /></span></a>)}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
