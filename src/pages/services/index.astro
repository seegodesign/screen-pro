---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight } from "@lucide/astro";
import ServiceCard from "../../components/ServiceCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { services } from "../../data/services";
import page from "../../data/pages/services.json";
import "../../styles/variables.css";
import "../../styles/services.css";

---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" type="image/png" href="/images/logomark.png" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">{page.hero.eyebrow}</p>
            <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          </div>
          <p>{page.hero.description}</p>
        </div>
      </section>

      <section class="services">
        <div class="container">
          <div class="services__head">
            <div><p class="eyebrow eyebrow--dark">{page.intro.eyebrow}</p><h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2></div>
            <p>{page.intro.description}</p>
          </div>
          <div class="service-grid">{services.map((service) => <ServiceCard {...service} />)}</div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">{page.cta.eyebrow}</p><h2>{page.cta.title}<br /><em>{page.cta.accent}</em></h2></div>
          <a href={page.cta.url}>{page.cta.label} <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
