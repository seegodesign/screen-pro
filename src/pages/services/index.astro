---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight } from "@lucide/astro";
import ServiceCard from "../../components/ServiceCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { services } from "../../data/services";
import "../../styles/variables.css";
import "../../styles/services.css";

const phone = "(808) 651-8664";
const tel = "+18086518664";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore custom retractable doors, power screens, window screens, sliding doors, hurricane protection, and screen repair on North, East, and South Kauaʻi." />
    <link rel="icon" href="/favicon.svg" />
    <title>Screen Services on Kauaʻi | Screen Pro</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">Our services</p>
            <h1>Custom screen solutions<br /><em>for island living.</em></h1>
          </div>
          <p>From a single repair to a fully motorized lanai, every system is measured, specified, and installed for your opening and the way you use your space.</p>
        </div>
      </section>

      <section class="services">
        <div class="container">
          <div class="services__head">
            <div><p class="eyebrow eyebrow--dark">What we do</p><h2>Doors, windows, lanais<br /><em>and everything between.</em></h2></div>
            <p>Explore our complete range of custom installation and repair services for Kauaʻi’s North Shore, East Side, and South Shore.</p>
          </div>
          <div class="service-grid">{services.map((service) => <ServiceCard {...service} />)}</div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta__inner">
          <div><p class="eyebrow">Not sure what you need?</p><h2>Start with a complimentary<br /><em>on-site consultation.</em></h2></div>
          <a href="/contact/">Discuss your project <ArrowUpRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
