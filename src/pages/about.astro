---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowUpRight, BadgeCheck, HeartHandshake, ShieldCheck, Waves } from "@lucide/astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/about.json";
import "../styles/variables.css";
import "../styles/about.css";

const yearsInBusiness = new Date().getFullYear() - siteSettings.foundingYear;
const principleIcons = { waves: Waves, shield: ShieldCheck, heart: HeartHandshake };
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" href="/favicon.svg" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="container hero__content">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          <p>{page.hero.description}</p>
        </div>
      </section>

      <section class="legacy section">
        <div class="container legacy__grid">
          <div class="legacy__image">
            <img src={page.legacy.image} alt={page.legacy.imageAlt} />
            <span><strong>{yearsInBusiness}+</strong> {page.legacy.badgeSuffix}</span>
          </div>
          <div class="legacy__content">
            <p class="eyebrow eyebrow--dark">{page.legacy.eyebrowPrefix} {siteSettings.foundingYear}</p>
            <h2>{page.legacy.title}<br /><em>{page.legacy.accent}</em></h2>
            <p class="lead">{page.legacy.leadPrefix} {yearsInBusiness - 1} {page.legacy.leadSuffix}</p>
            {page.legacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="principles section">
        <div class="container">
          <div class="principles__head">
            <div><p class="eyebrow eyebrow--dark">{page.principles.eyebrow}</p><h2>{page.principles.title}<br /><em>{page.principles.accent}</em></h2></div>
            <p>{page.principles.description}</p>
          </div>
          <div class="principles__grid">
            {page.principles.items.map((item) => {
              const Icon = principleIcons[item.icon as keyof typeof principleIcons];
              return <article><Icon aria-hidden="true" /><h3>{item.title}</h3><p>{item.copy}</p></article>;
            })}
          </div>
        </div>
      </section>

      <section class="expertise section">
        <div class="container expertise__grid">
          <div>
            <p class="eyebrow">{page.expertise.eyebrow}</p>
            <h2>{page.expertise.title}<br /><em>{page.expertise.accent}</em></h2>
            {page.expertise.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <a href={page.expertise.linkUrl}>{page.expertise.linkLabel} <ArrowUpRight aria-hidden="true" /></a>
          </div>
          <div class="expertise__points">
            {page.expertise.points.map((point) => <div><BadgeCheck aria-hidden="true" /><span><strong>{point.title}</strong>{point.copy}</span></div>)}
          </div>
        </div>
      </section>

      <section class="ohana section">
        <div class="container ohana__grid">
          <div class="ohana__image"><img src={page.ohana.image} alt={page.ohana.imageAlt} loading="lazy" /></div>
          <div>
            <p class="eyebrow eyebrow--dark">{page.ohana.eyebrow}</p>
            <h2>{page.ohana.title}<br /><em>{page.ohana.accent}</em></h2>
            {page.ohana.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <a class="button" href={page.ohana.linkUrl}>{page.ohana.linkLabel} <ArrowUpRight aria-hidden="true" /></a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
