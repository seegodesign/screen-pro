---
import { ClientRouter, fade } from "astro:transitions";
import { ArrowRight } from "@lucide/astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import page from "../data/pages/gallery.json";
import { galleryItems } from "../data/cms";
import "../styles/variables.css";
import "../styles/gallery.css";

---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <SeoHead title={page.seoTitle} description={page.seoDescription} path="/gallery/" />
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />
    <main>
      <section class="gallery-hero">
        <div class="container gallery-hero__grid">
          <div>
            <p class="eyebrow">{page.hero.eyebrow}</p>
            <h1>{page.hero.title} <em>{page.hero.accent}</em></h1>
          </div>
          <p>{page.hero.description}</p>
        </div>
      </section>

      <section class="gallery-page section" aria-label={page.galleryLabel}>
        <div class="container gallery-page__grid">
          {galleryItems.map((item) => (
            <figure class:list={["gallery-card", { "gallery-card--featured": item.featured }]}>
              <img src={item.src} alt={item.alt} loading="lazy" />
              <figcaption><span>{item.title}</span><small>{item.location}</small></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="gallery-cta">
        <div class="container gallery-cta__inner">
          <div><p class="eyebrow">{page.cta.eyebrow}</p><h2>{page.cta.title}<br /><em>{page.cta.accent}</em></h2></div>
          <a href={page.cta.url}>{page.cta.label} <ArrowRight aria-hidden="true" /></a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
