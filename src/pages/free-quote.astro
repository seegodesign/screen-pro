---
import { ClientRouter, fade } from "astro:transitions";
import SeoHead from "../components/SeoHead.astro";
import QuoteSection from "../components/QuoteSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import page from "../data/pages/free-quote.json";
import "../styles/variables.css";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <SeoHead title={page.seoTitle} description={page.seoDescription} path="/free-quote/" />
    <ClientRouter />
  </head>
  <body class="quote-page">
    <SiteHeader quoteHref="/free-quote/" />
    <main><QuoteSection /></main>
    <SiteFooter />
  </body>
</html>
