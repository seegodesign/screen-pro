---
import { ClientRouter, fade } from "astro:transitions";
import QuoteSection from "../components/QuoteSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import page from "../data/pages/free-quote.json";
import "../styles/variables.css";
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={page.seoDescription} />
    <link rel="icon" type="image/png" href="/images/logomark.png" />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body class="quote-page">
    <SiteHeader quoteHref="/free-quote/" />
    <main><QuoteSection /></main>
    <SiteFooter />
  </body>
</html>
