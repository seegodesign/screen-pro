---
import { ClientRouter, fade } from "astro:transitions";
import {
  BadgeCheck,
  Factory,
  Handshake,
  HeartHandshake,
  Phone,
  Ruler,
  ShieldCheck,
} from "@lucide/astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ValueCard from "../components/ValueCard.astro";
import { serviceAreas } from "../data/service-areas";
import { services } from "../data/services";
import "../styles/variables.css";

const brands = [
  [
    "ClearView",
    "Premium retractable door systems with an exceptionally clean profile.",
    "/images/brand-logos/clearview.png",
    true,
  ],
  [
    "Rainier Shading",
    "Our preferred motorized screens for refined outdoor living spaces.",
    "/images/brand-logos/rainier.avif",
    true,
  ],
  [
    "Wizard Screens & Shades",
    "Versatile retractable and motorized options for custom openings.",
    "/images/brand-logos/wizard.svg",
    true,
  ],
  [
    "Centor",
    "High-end systems engineered for expansive, large-format openings.",
    "/images/brand-logos/centor.svg",
    true,
  ],
  [
    "Hurricane Fabric",
    "Tested fabric protection that deploys quickly and stores compactly.",
    "/images/brand-logos/hurricane-fabric.webp",
    false,
  ],
];

const reasons = [
  {
    title: "Quality products",
    copy: "We select proven retractable screen and shade systems that meet our standards for durability, clean design, and dependable everyday performance.",
    image: "/images/screen-installation-1.avif",
    icon: BadgeCheck,
  },
  {
    title: "Personal service",
    copy: "From the first site visit through long-term support, you work with a local team that listens carefully, communicates clearly, and stands behind the work.",
    image: "/images/screen-installation-2.avif",
    icon: Handshake,
  },
  {
    title: "Professional installation",
    copy: "Every opening is measured precisely and installed with close attention to fit, finish, smooth operation, and respect for your home or business.",
    image: "/images/screen-installation-3.avif",
    icon: Ruler,
  },
];

const values = [
  {
    title: "Reliable",
    copy: "Reliability is ingrained in our company culture. Count on consistent performance, timely projects, and a steadfast commitment to your needs—giving you confidence in every door and window solution.",
    icon: ShieldCheck,
    image: "/images/custom-screen-installation-kauai.jpg",
  },
  {
    title: "Family owned",
    copy: "We are more than a business—we are family. Integrity, personal care, and community shape every interaction. When you choose Screen Pro, you become a valued member of our ʻohana.",
    icon: HeartHandshake,
    image: "/images/Screen-Pro-Retractable-Doors-Kauai.jpg",
  },
  {
    title: "OEM dealer",
    copy: "As an authorized OEM dealer, we provide genuine products from leading manufacturers, pairing the latest innovations and highest-quality options with knowledgeable local craftsmanship.",
    icon: Factory,
    image: "/images/closing-screen-slider-door.avif",
  },
];

const reviews = [
  {
    quote:
      "Screen Pro made the entire process easy. The communication was excellent, the installation was clean, and the retractable screens feel like they were always part of the house.",
    name: "Malia R.",
    place: "Princeville",
  },
  {
    quote:
      "We had a very wide lanai opening and wanted something that would disappear when not in use. The finished motorized screen is beautiful and works flawlessly.",
    name: "David K.",
    place: "Poʻipū",
  },
  {
    quote:
      "They repaired two old sliders other companies wanted to replace. Honest advice, quality parts, and both doors glide better than they have in years.",
    name: "Anne P.",
    place: "Kapaʻa",
  },
];

const phone = "(808) 651-8664";
const tel = "+18086518664";
const siteUrl = "https://kauairetractablescreens.com";
const businessId = `${siteUrl}/#business`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "Screen Pro Retractable Doors",
      publisher: { "@id": businessId },
      inLanguage: "en-US",
    },
    {
      "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
      "@id": businessId,
      name: "Screen Pro Retractable Doors",
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/logo.webp`,
      image: `${siteUrl}/images/kauai-luxury-motorized-screen.jpg`,
      description:
        "Custom retractable screen doors, motorized screens, window screens, sliding screen doors, hurricane screens, and screen repair for homes on North, East, and South Kauaʻi.",
      telephone: tel,
      email: "info@kauairetractablescreens.com",
      foundingDate: "1998",
      areaServed: [
        { "@type": "AdministrativeArea", name: "Kauaʻi, Hawaii" },
        ...serviceAreas.map((town) => ({
          "@type": "City",
          name: `${town}, Hawaii`,
        })),
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Screen installation and repair services",
        itemListElement: services.map((service) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: service.title,
            description: service.copy,
            provider: { "@id": businessId },
            areaServed: [
              { "@type": "AdministrativeArea", name: "Kauaʻi, Hawaii" },
              ...serviceAreas.map((town) => ({
                "@type": "City",
                name: `${town}, Hawaii`,
              })),
            ],
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 350 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Premium custom screen doors, window screens, motorized screens, hurricane screens, and screen repair for homes on Kauaʻi’s North Shore, East Side, and South Shore."
    />
    <meta name="theme-color" content="#12324a" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>Screen Doors Kauai | Retractable, Motorized & Screen Repair</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="hero__media">
          <video
            autoplay
            muted
            playsinline
            preload="metadata"
            poster="/images/hero-video-poster.webp"
            aria-hidden="true"
            tabindex="-1"
          >
            <source src="/motorized-screen.webm" type="video/webm" />
          </video>
        </div>
        <div class="hero__shade"></div>
        <div class="container hero__content">
          <div class="eyebrow eyebrow--light">
            <span></span> Kauaʻi’s custom screen specialists
          </div>
          <h1>Premium screen solutions<br /><em>for Kauaʻi homes.</em></h1>
          <p class="hero__lede">
            Designed for Hawaii homes—from retractable doors to wide motorized
            screens, built and installed to last.
          </p>
          <div class="hero__actions">
            <a class="button button--bronze" href="/free-quote/"
              >Get a free quote <span class="button__arrow" aria-hidden="true"
                ><svg viewBox="0 0 16 16"
                  ><path d="M4 12 12 4M6 4h6v6"></path></svg
                ></span
              ></a
            >
            <a class="button button--glass" href={`tel:${tel}`}>
              <Phone class="button__icon" aria-hidden="true" /><span
                ><small>Call us today</small>{phone}</span
              >
            </a>
          </div>
        </div>
        <div class="container hero__foot">
          <div class="hero__trust">
            <strong>25+</strong>
            <span>Years serving<br />Kauaʻi homeowners</span>
          </div>
          <div class="hero__trust">
            <strong>5.0</strong>
            <span><b>★★★★★</b><br />Local customer rating</span>
          </div>
          <div class="hero__location">
            <span>North Shore</span><i></i><span>East Side</span><i></i><span
              >South Side</span
            >
          </div>
        </div>
      </section>

      <section class="intro section">
        <div class="container intro__grid">
          <div>
            <div class="eyebrow"><span></span> More than a screen company</div>
            <h2>Kauaʻi’s complete<br /><em>screen service company.</em></h2>
          </div>
          <div class="intro__copy">
            <p class="lead">
              The right screen should feel like it was designed with your
              home—not added after the fact.
            </p>
            <p>
              We help Kauaʻi homeowners choose, install, and maintain the right
              screen system—from a single window repair to a fully motorized
              lanai. We specify quality aluminum, proven hardware, and systems
              we can service down the road.
            </p>
            <div class="intro__details">
              <span><b>Custom fit</b>Measured on site</span>
              <span><b>Three regions</b>North · East · South</span>
              <span><b>Built to last</b>Serviceable systems</span>
            </div>
            <a class="text-link" href="#about"
              >Why homeowners choose us <span>→</span></a
            >
          </div>
        </div>
      </section>

      <section class="services section" id="services">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow"><span></span> What we do</div>
              <h2>Custom screens for doors,<br /><em>windows & lanais.</em></h2>
            </div>
            <p>
              Custom work for doors, windows, decks, lanais, and large
              architectural openings throughout our Kauaʻi service areas.
            </p>
          </div>
          <div class="service-grid">
            {services.map((service) => <ServiceCard {...service} />)}
          </div>
        </div>
      </section>

      <section class="why section">
        <div class="container">
          <div class="why__head">
            <div class="eyebrow"><span></span> Why Screen Pro</div>
            <h2>Why choose <em>us?</em></h2>
            <p>
              We are Kauaʻi’s exclusive dealer for leading retractable screen
              and power-shade systems. For more than 25 years, we have gone the
              extra mile to deliver thoughtful recommendations, careful
              installation, and lasting local support.
            </p>
          </div>
          <div class="why__grid">
            {
              reasons.map((reason) => (
                <ValueCard {...reason} variant="feature" />
              ))
            }
          </div>
          <div class="values-grid">
            {values.map((value) => <ValueCard {...value} />)}
          </div>
        </div>
      </section>

      <section class="feature section" id="about">
        <div class="container feature__grid">
          <div class="feature__image-wrap">
            <div class="feature__image"></div>
            <div class="feature__badge">
              <strong>Custom fit</strong><span
                >Measured & installed on site</span
              >
            </div>
          </div>
          <div class="feature__content">
            <div class="eyebrow eyebrow--light">
              <span></span> Built around your home
            </div>
            <h2>
              Custom-fit screen installation<br /><em
                >built for Kauaʻi homes.</em
              >
            </h2>
            <p class="lead">
              They should work smoothly, look intentional, and let the breeze in
              without competing with your view.
            </p>
            <p>
              That is why we begin with an on-site consultation. We look at the
              opening, traffic flow, exposure, and how you use the space—then
              recommend the system that makes sense. No hard sell. No
              one-size-fits-all shortcut.
            </p>
            <div class="feature__points">
              <div>
                <strong>01</strong><span
                  ><b>Measured precisely</b>Custom fabricated for a clean fit.</span
                >
              </div>
              <div>
                <strong>02</strong><span
                  ><b>Installed professionally</b>Detailed work, respectful job
                  sites.</span
                >
              </div>
              <div>
                <strong>03</strong><span
                  ><b>Serviceable for years</b>Quality parts we can maintain
                  later.</span
                >
              </div>
            </div>
            <a class="button button--bronze" href="/free-quote/"
              >Schedule a consultation <span
                class="button__arrow"
                aria-hidden="true"
                ><svg viewBox="0 0 16 16"
                  ><path d="M4 12 12 4M6 4h6v6"></path></svg
                ></span
              ></a
            >
          </div>
        </div>
      </section>

      <section class="brands section" id="brands">
        <div class="container">
          <div class="brands__head">
            <div>
              <div class="eyebrow"><span></span> Trusted systems</div>
              <h2>
                Trusted retractable & motorized<br /><em>screen brands.</em>
              </h2>
            </div>
            <p>
              We partner with manufacturers whose products meet our standards
              for performance, finish, and long-term serviceability.
            </p>
          </div>
          <div class="brand-list">
            {
              brands.map(([name, copy, logo, monochrome], index) => (
                <article class="brand-row">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div class="brand-row__identity">
                    <img
                      class:list={[
                        "brand-row__logo",
                        { "brand-row__logo--monochrome": monochrome },
                      ]}
                      src={logo}
                      alt={`${name} logo`}
                      loading="lazy"
                    />
                    <h3 class="sr-only">{name}</h3>
                  </div>
                  <p>{copy}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="gallery section" id="gallery">
        <div class="container">
          <div class="section-head section-head--gallery">
            <div>
              <div class="eyebrow"><span></span> Recent work</div><h2>
                Recent screen installations<br /><em>on Kauaʻi.</em>
              </h2>
            </div>
            <a class="text-link" href="/free-quote/"
              >Plan your project <span>→</span></a
            >
          </div>
          <div class="gallery__grid">
            <figure class="gallery__item gallery__item--wide">
              <div class="gallery__photo gallery__photo--one"></div>
              <figcaption>
                <div>
                  <span>Motorized lanai screen</span><small>North Shore</small>
                </div><a
                  class="gallery__cta gallery__cta--motorized"
                  href="/free-quote/">Plan yours <b>→</b></a
                >
              </figcaption>
            </figure>
            <figure class="gallery__item">
              <div class="gallery__photo gallery__photo--two"></div>
              <figcaption>
                <div>
                  <span>Retractable French door</span><small>East Side</small>
                </div><a class="gallery__cta gallery__cta--door" href="/free-quote/"
                  >Plan yours <b>→</b></a
                >
              </figcaption>
            </figure>
            <figure class="gallery__item">
              <div class="gallery__photo gallery__photo--three"></div>
              <figcaption>
                <div>
                  <span>Custom window screens</span><small>South Side</small>
                </div><a
                  class="gallery__cta gallery__cta--windows"
                  href="/free-quote/">Plan yours <b>→</b></a
                >
              </figcaption>
            </figure>
            <figure class="gallery__item">
              <div class="gallery__photo gallery__photo--four"></div>
              <figcaption>
                <div>
                  <span>Custom screen installation</span><small>Kauaʻi</small>
                </div><a class="gallery__cta" href="/free-quote/"
                  >Plan yours <b>→</b></a
                >
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="reviews section" id="reviews">
        <div class="container">
          <div class="reviews__top">
            <div>
              <div class="eyebrow eyebrow--light">
                <span></span> Homeowner reviews
              </div><h2>
                Kauaʻi screen installation<br /><em>& repair reviews.</em>
              </h2>
            </div>
            <div class="rating">
              <strong>5.0</strong><span
                ><b>★★★★★</b><small>Based on local customer reviews</small
                ></span
              >
            </div>
          </div>
          <div class="review-grid">
            {
              reviews.map((review) => (
                <blockquote class="review-card">
                  <div class="review-card__stars">★★★★★</div>
                  <p>“{review.quote}”</p>
                  <footer>
                    <>
                      <span>{review.name.slice(0, 1)}</span>
                      <div>
                        <>
                          <strong>{review.name}</strong>
                          <small>{review.place}, Kauaʻi</small>
                        </>
                      </div>
                    </>
                  </footer>
                </blockquote>
              ))
            }
          </div>
        </div>
      </section>

      <section class="area section" id="service-area">
        <div class="container area__grid">
          <div class="area__map">
            <img src="/images/map.avif" alt="Map of Kauaʻi service areas" />
            <span class="area__label area__label--north">North Shore</span>
            <span class="area__label area__label--east">East Side</span>
            <span class="area__label area__label--south">South Side</span>
          </div>
          <div class="area__content">
            <div class="eyebrow"><span></span> Three service regions</div>
            <h2>
              Screen service across<br /><em>North, East & South Kauaʻi.</em>
            </h2>
            <p>
              From Hanalei and Princeville to Anahola, Kapaʻa, Līhuʻe, Kōloa,
              and Poʻipū, we bring experienced screen installation and repair
              directly to your home.
            </p>
            <ul>
              <li>
                <a href="/service-areas/north-shore-kauai/"
                  ><span>North Shore</span><small
                    >Hanalei · Princeville · Kīlauea</small
                  ><b>→</b></a
                >
              </li>
              <li>
                <a href="/service-areas/east-side-kauai/"
                  ><span>East Side</span><small
                    >Anahola · Kapaʻa · Wailua · Līhuʻe</small
                  ><b>→</b></a
                >
              </li>
              <li>
                <a href="/service-areas/south-shore-kauai/"
                  ><span>South Shore</span><small
                    >Kōloa · Poʻipū · Kalāheo</small
                  ><b>→</b></a
                >
              </li>
            </ul>
          </div>
        </div>
      </section>

    </main>

    <SiteFooter />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    color: var(--color-ink);
    background: var(--color-cream);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  p,
  h1,
  h2,
  h3 {
    margin-top: 0;
  }
  button,
  input,
  textarea,
  select {
    font: inherit;
  }
  .container {
    width: min(calc(100% - 48px), var(--container));
    margin-inline: auto;
  }
  .section {
    padding: var(--space-8) 0;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-headline);
  }
  h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 400;
  }
  h2 {
    margin-bottom: 0;
    font-size: clamp(2.2rem, 3.7vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  h1 em,
  h2 em {
    font-weight: 400;
    color: var(--color-bronze-light);
    font-style: italic;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--color-ocean);
    font-size: 0.7rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .eyebrow > span {
    display: none;
  }
  .eyebrow--light {
    color: rgba(255, 255, 255, 0.7);
  }
  .button {
    min-height: 54px;
    padding: 0 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    border: 1px solid transparent;
    cursor: pointer;
    font-size: 0.76rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 700;
    transition: 0.25s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button__arrow {
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }
  .button__arrow svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .button:hover .button__arrow {
    background: rgba(255, 255, 255, 0.12);
    transform: translate(2px, -2px);
  }
  .button--dark {
    color: white;
    background: var(--color-navy);
  }
  .button--bronze {
    color: white;
    background: var(--color-bronze);
  }
  .button--bronze:hover {
    background: #a97543;
  }
  .button--glass,
  .button--outline {
    color: white;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }
  .button--glass {
    min-width: 215px;
    justify-content: flex-start;
    text-transform: none;
    letter-spacing: 0;
  }
  .button--glass small {
    display: block;
    opacity: 0.7;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .button__icon {
    width: 1.4rem;
    height: 1.4rem;
    flex: 0 0 auto;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .topbar {
    color: rgba(255, 255, 255, 0.84);
    background: var(--color-navy-deep);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .topbar__inner {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .topbar p {
    margin: 0;
  }
  .topbar__meta {
    display: flex;
    gap: 2rem;
  }
  .topbar__meta a {
    color: white;
    font-weight: 600;
  }
  .header {
    position: sticky;
    z-index: 20;
    top: 0;
    background: #f9f5ef;
  }
  .header__inner {
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-navy);
  }
  .logo--nav img {
    width: 220px;
    height: auto;
    display: block;
  }
  .logo__mark {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .logo__type {
    display: grid;
    line-height: 1;
  }
  .logo__type strong {
