---
import { ClientRouter, fade } from "astro:transitions";
import {
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  Factory,
  Handshake,
  HeartHandshake,
  Phone,
  Ruler,
  ShieldCheck,
} from "@lucide/astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ValueCard from "../components/ValueCard.astro";
import { serviceAreas } from "../data/service-areas";
import { services } from "../data/services";
import { siteSettings } from "../data/site-settings";
import page from "../data/pages/home.json";
import { galleryItems, partners as brands, reviews } from "../data/cms";
import "../styles/variables.css";
import "../styles/home.css";

const icons = { badge: BadgeCheck, handshake: Handshake, ruler: Ruler, shield: ShieldCheck, heart: HeartHandshake, factory: Factory };
const reasons = page.why.reasons.map((item) => ({ ...item, icon: icons[item.icon as keyof typeof icons] }));
const values = page.why.values.map((item) => ({ ...item, icon: icons[item.icon as keyof typeof icons] }));

const siteUrl = siteSettings.siteUrl;
const businessId = `${siteUrl}/#business`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: siteSettings.businessName,
      publisher: { "@id": businessId },
      inLanguage: "en-US",
    },
    {
      "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
      "@id": businessId,
      name: siteSettings.businessName,
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/logo.webp`,
      image: `${siteUrl}/images/kauai-luxury-motorized-screen.jpg`,
      description: siteSettings.defaultMetaDescription,
      telephone: siteSettings.phoneNumber,
      email: siteSettings.email,
      foundingDate: String(siteSettings.foundingYear),
      areaServed: [
        { "@type": "AdministrativeArea", name: "Kauaʻi, Hawaii" },
        ...serviceAreas.map((town) => ({
          "@type": "City",
          name: `${town}, Hawaii`,
        })),
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Screen installation and repair services",
        itemListElement: services.map((service) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: service.title,
            description: service.copy,
            provider: { "@id": businessId },
            areaServed: [
              { "@type": "AdministrativeArea", name: "Kauaʻi, Hawaii" },
              ...serviceAreas.map((town) => ({
                "@type": "City",
                name: `${town}, Hawaii`,
              })),
            ],
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 300 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={page.seoDescription}
    />
    <meta name="theme-color" content="#12324a" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{page.seoTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader quoteHref="/free-quote/" />

    <main>
      <section class="hero">
        <div class="hero__media">
          <video
            autoplay
            muted
            playsinline
            preload="metadata"
            poster={page.hero.poster}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={page.hero.video} type="video/webm" />
          </video>
        </div>
        <div class="hero__shade"></div>
        <div class="container hero__content">
          <div class="eyebrow eyebrow--light">
            <span></span> {page.hero.eyebrow}
          </div>
          <h1>{page.hero.title}<br /><em>{page.hero.accent}</em></h1>
          <p class="hero__lede">{page.hero.description}</p>
          <div class="hero__actions">
            <a class="button button--bronze" href={page.hero.quoteUrl}
              >{page.hero.quoteLabel} <span class="button__arrow" aria-hidden="true"
                ><svg viewBox="0 0 16 16"
                  ><path d="M4 12 12 4M6 4h6v6"></path></svg
                ></span
              ></a
            >
            <a class="button button--glass" href={`tel:${siteSettings.phoneNumber}`}>
              <span><small>{page.hero.phoneLabel}</small>{siteSettings.phoneDisplay}</span>
              <Phone class="button__icon" aria-hidden="true" />
            </a>
          </div>
        </div>
        <div class="container hero__foot">
          {page.hero.trust.map((item, index) => <div class="hero__trust"><strong>{item.value}</strong><span>{index === 1 && <b>★★★★★</b>}<br />{item.label}</span></div>)}
          <div class="hero__location">
            {page.hero.regions.map((region, index) => <><span>{region}</span>{index < page.hero.regions.length - 1 && <i></i>}</>)}
          </div>
        </div>
      </section>

      <section class="intro section">
        <div class="container intro__grid">
          <div>
            <div class="eyebrow"><span></span> {page.intro.eyebrow}</div>
            <h2>{page.intro.title}<br /><em>{page.intro.accent}</em></h2>
          </div>
          <div class="intro__copy">
            <p class="lead">{page.intro.lead}</p>
            <p>{page.intro.description}</p>
            <div class="intro__details">
              {page.intro.details.map((item) => <span><b>{item.title}</b>{item.copy}</span>)}
            </div>
            <a class="text-link" href={page.intro.linkUrl}
              >{page.intro.linkLabel} <span><ArrowRight aria-hidden="true" /></span></a
            >
          </div>
        </div>
      </section>

      <section class="services section" id="services">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow"><span></span> {page.servicesSection.eyebrow}</div>
              <h2>{page.servicesSection.title}<br /><em>{page.servicesSection.accent}</em></h2>
            </div>
            <p>{page.servicesSection.description}</p>
          </div>
          <div class="service-grid">
            {services.map((service) => <ServiceCard {...service} />)}
          </div>
        </div>
      </section>

      <section class="why section" id="why">
        <div class="container">
          <div class="why__head">
            <div class="eyebrow"><span></span> {page.why.eyebrow}</div>
            <h2>{page.why.title} <em>{page.why.accent}</em></h2>
            <p>{page.why.description}</p>
          </div>
          <div class="why__grid">
            {
              reasons.map((reason) => (
                <ValueCard {...reason} variant="feature" />
              ))
            }
          </div>
          <div class="values-grid">
            {values.map((value) => <ValueCard {...value} />)}
          </div>
        </div>
      </section>

      <section class="feature section" id="about">
        <div class="container feature__grid">
          <div class="feature__image-wrap">
            <div class="feature__image" style={`background-image:url("${page.feature.image}")`} role="img" aria-label={page.feature.imageAlt}></div>
            <div class="feature__badge">
              <strong>{page.feature.badgeTitle}</strong><span>{page.feature.badgeCopy}</span>
            </div>
          </div>
          <div class="feature__content">
            <div class="eyebrow eyebrow--light">
              <span></span> {page.feature.eyebrow}
            </div>
            <h2>
              {page.feature.title}<br /><em>{page.feature.accent}</em>
            </h2>
            <p class="lead">{page.feature.lead}</p>
            <p>{page.feature.description}</p>
            <div class="feature__points">
              {page.feature.points.map((item, index) => <div><strong>{String(index + 1).padStart(2, "0")}</strong><span><b>{item.title}</b>{item.copy}</span></div>)}
            </div>
            <a class="button button--bronze" href={page.feature.linkUrl}
              >{page.feature.linkLabel} <span
                class="button__arrow"
                aria-hidden="true"
                ><svg viewBox="0 0 16 16"
                  ><path d="M4 12 12 4M6 4h6v6"></path></svg
                ></span
              ></a
            >
          </div>
        </div>
      </section>

      <section class="brands section" id="brands">
        <div class="container">
          <div class="brands__head">
            <div>
              <div class="eyebrow"><span></span> {page.brandsSection.eyebrow}</div>
              <h2>
                {page.brandsSection.title}<br /><em>{page.brandsSection.accent}</em>
              </h2>
            </div>
            <p>{page.brandsSection.description}</p>
          </div>
          <div class="brand-list">
            {
              brands.map((brand, index) => (
                <article class="brand-row">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <a
                    class="brand-row__identity"
                    href={brand.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit ${brand.shortName} website`}
                  >
                    <img
                      class:list={[
                        "brand-row__logo",
                        { "brand-row__logo--monochrome": brand.monochrome },
                      ]}
                      src={brand.logo}
                      alt={`${brand.shortName} logo`}
                      loading="lazy"
                    />
                    <h3 class="sr-only">{brand.shortName}</h3>
                  </a>
                  <div class="brand-row__content">
                    <p>{brand.homepageCopy}</p>
                    <a href={brand.url} target="_blank" rel="noopener noreferrer">
                      {page.brandsSection.linkLabel} <ArrowUpRight aria-hidden="true" />
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="gallery section" id="gallery">
        <div class="container">
          <div class="section-head section-head--gallery">
            <div>
              <div class="eyebrow"><span></span> {page.gallerySection.eyebrow}</div><h2>
                {page.gallerySection.title}<br /><em>{page.gallerySection.accent}</em>
              </h2>
            </div>
            <a class="text-link" href={page.gallerySection.linkUrl}
              >{page.gallerySection.linkLabel} <span><ArrowRight aria-hidden="true" /></span></a
            >
          </div>
          <div class="gallery__grid">
            {galleryItems.filter((item) => item.featured).slice(0, 4).map((item, index) => (
              <figure class:list={["gallery__item", { "gallery__item--wide": index === 0 }]}>
                <div class="gallery__photo" style={`background-image:url("${item.src}")`} role="img" aria-label={item.alt}></div>
                <figcaption>
                  <div><span>{item.title}</span><small>{item.location}</small></div>
                  <a class="gallery__cta" href={page.gallerySection.itemLinkUrl}>{page.gallerySection.itemLinkLabel} <b><ArrowRight aria-hidden="true" /></b></a>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="reviews section" id="reviews">
        <div class="container">
          <div class="reviews__top">
            <div>
              <div class="eyebrow eyebrow--light">
                <span></span> {page.reviewsSection.eyebrow}
              </div><h2>
                {page.reviewsSection.title}<br /><em>{page.reviewsSection.accent}</em>
              </h2>
            </div>
            <div class="reviews__actions">
              <div class="rating">
                <strong>{page.reviewsSection.rating}</strong><span
                  ><b>★★★★★</b><small>{page.reviewsSection.ratingLabel}</small
                  ></span
                >
              </div>
              <a class="text-link" href={page.reviewsSection.linkUrl}>{page.reviewsSection.linkLabel} <span><ArrowRight aria-hidden="true" /></span></a>
            </div>
          </div>
          <div class="review-grid">
            {
              reviews.map((review) => (
                <blockquote class="review-card">
                  <div class="review-card__stars">★★★★★</div>
                  <p>“{review.quote}”</p>
                  <footer>
                    <>
                      <span>{review.name.slice(0, 1)}</span>
                      <div>
                        <>
                          <strong>{review.name}</strong>
                          <small>{review.place}, Kauaʻi</small>
                        </>
                      </div>
                    </>
                  </footer>
                </blockquote>
              ))
            }
          </div>
        </div>
      </section>

      <section class="area section" id="service-area">
        <div class="container area__grid">
          <div class="area__map">
            <img src={page.area.map} alt={page.area.mapAlt} />
            <span class="area__label area__label--north">{page.area.regions[0].name}</span>
            <span class="area__label area__label--east">{page.area.regions[1].name}</span>
            <span class="area__label area__label--south">{page.area.regions[2].name}</span>
            <span class="area__label area__label--west">{page.area.regions[3].name}</span>
          </div>
          <div class="area__content">
            <div class="eyebrow"><span></span> {page.area.eyebrow}</div>
            <h2>
              {page.area.title}<br /><em>{page.area.accent}</em>
            </h2>
            <p>{page.area.description}</p>
            <ul>
              {page.area.regions.map((region) => <li><a href={region.url}><span>{region.name}</span><small>{region.towns}</small><b><ArrowRight aria-hidden="true" /></b></a></li>)}
            </ul>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
