---
import { ClientRouter, fade } from "astro:transitions";
import {
  Blinds,
  DoorOpen,
  PanelsTopLeft,
  PanelTop,
  ShieldCheck,
  Wrench,
} from "@lucide/astro";

const services = [
  {
    num: "01",
    slug: "screen-doors",
    title: "Retractable Screen Doors",
    copy: "Low-profile screens for single, double, French, and patio doors—custom fit so the view stays open when the screen is away.",
    tags: ["Single & double doors", "French doors"],
    icon: DoorOpen,
  },
  {
    num: "02",
    slug: "motorized-screens",
    title: "Motorized Screens",
    copy: "Remote-controlled shade and bug protection for wide lanais, decks, outdoor kitchens, and other large-format openings.",
    tags: ["Large openings", "Sun + insect control"],
    icon: Blinds,
  },
  {
    num: "03",
    slug: "window-screens",
    title: "Window Screens",
    copy: "New aluminum frames and precise re-screening in white or bronze, with charcoal and light-gray mesh options.",
    tags: ["New frames", "Re-screening"],
    icon: PanelsTopLeft,
  },
  {
    num: "04",
    slug: "sliding-screen-doors",
    title: "Sliding Screen Doors",
    copy: "Durable aluminum doors with nylon wheels, adjusted on site for a smooth glide and a clean, dependable close.",
    tags: ["Aluminum frames", "Smooth operation"],
    icon: PanelTop,
  },
  {
    num: "05",
    slug: "hurricane-screens",
    title: "Hurricane Screens",
    copy: "Hurricane-rated fabric protection that is easy to deploy, compact to store, and fitted for inside or outside access.",
    tags: ["Compact storage", "Custom installation"],
    icon: ShieldCheck,
  },
  {
    num: "06",
    slug: "screen-repair",
    title: "Screen Repair",
    copy: "Re-screening, wheel and hydraulic tube replacement, clips, springs, and an honest assessment of tired frames.",
    tags: ["Serviceable repairs", "All screen types"],
    icon: Wrench,
  },
];

const brands = [
  ["CLEARVIEW", "Premium retractable door systems with an exceptionally clean profile."],
  ["RAINIER", "Our preferred motorized screens for refined outdoor living spaces."],
  ["WIZARD", "Versatile retractable and motorized options for custom openings."],
  ["CENTAUR", "High-end systems engineered for expansive, large-format openings."],
  ["HURRICANE FABRIC", "Tested fabric protection that deploys quickly and stores compactly."],
];

const reviews = [
  {
    quote: "Screen Pro made the entire process easy. The communication was excellent, the installation was clean, and the retractable screens feel like they were always part of the house.",
    name: "Malia R.",
    place: "Princeville",
  },
  {
    quote: "We had a very wide lanai opening and wanted something that would disappear when not in use. The finished motorized screen is beautiful and works flawlessly.",
    name: "David K.",
    place: "Poʻipū",
  },
  {
    quote: "They repaired two old sliders other companies wanted to replace. Honest advice, quality parts, and both doors glide better than they have in years.",
    name: "Anne P.",
    place: "Kapaʻa",
  },
];

const phone = "(808) 651-8664";
const tel = "+18086518664";
const siteUrl = "https://kauairetractablescreens.com";
const businessId = `${siteUrl}/#business`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "Screen Pro Retractable Doors",
      publisher: { "@id": businessId },
      inLanguage: "en-US",
    },
    {
      "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
      "@id": businessId,
      name: "Screen Pro Retractable Doors",
      url: `${siteUrl}/`,
      logo: `${siteUrl}/images/logo.png`,
      image: `${siteUrl}/images/kauai-luxury-motorized-screen.jpg`,
      description:
        "Custom retractable screen doors, motorized screens, window screens, sliding screen doors, hurricane screens, and screen repair for homes across Kauaʻi.",
      telephone: tel,
      email: "info@kauairetractablescreens.com",
      foundingDate: "1998",
      areaServed: {
        "@type": "AdministrativeArea",
        name: "Kauaʻi, Hawaii",
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Screen installation and repair services",
        itemListElement: services.map((service) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: service.title,
            description: service.copy,
            provider: { "@id": businessId },
            areaServed: {
              "@type": "AdministrativeArea",
              name: "Kauaʻi, Hawaii",
            },
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: 350 })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Premium custom screen doors, window screens, motorized screens, hurricane screens, and screen repair for Kauai homes. Island-wide service and expert installation." />
    <meta name="theme-color" content="#12324a" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>Screen Doors Kauai | Retractable, Motorized & Screen Repair</title>
    <ClientRouter />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar__inner">
        <p>Custom-fit screen solutions, built for island living.</p>
        <div class="topbar__meta">
          <span>Serving all of Kauaʻi</span>
          <a href={`tel:${tel}`}>{phone}</a>
        </div>
      </div>
    </div>

    <header class="header">
      <div class="container header__inner">
        <a class="logo logo--nav" href="/" aria-label="Screen Pro Retractable Doors home">
          <img src="/images/logo.png" width="400" height="154" alt="Screen Pro Retractable Doors" />
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <div class="nav-services">
            <button type="button" aria-haspopup="true">Services</button>
            <div class="services-dropdown">
              {services.map((service) => <a href={`/services/${service.slug}/`}>{service.title}</a>)}
            </div>
          </div>
          <a href="#brands">Brands</a>
          <a href="#about">About</a>
          <a href="#reviews">Reviews</a>
          <a href="#gallery">Gallery</a>
        </nav>
        <a class="button button--dark header__cta" href="#contact">Get a quote <span>↗</span></a>
        <button class="menu-button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
      </div>
      <div class="mobile-nav">
        <strong>Services</strong>
        {services.map((service) => <a href={`/services/${service.slug}/`}>{service.title}</a>)}
        <a href="#brands">Brands</a><a href="#about">About</a>
        <a href="#reviews">Reviews</a><a href="#gallery">Gallery</a><a href="#contact">Get a quote</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero__media"></div>
        <div class="hero__shade"></div>
        <div class="container hero__content">
          <div class="eyebrow eyebrow--light"><span></span> Kauaʻi’s custom screen specialists</div>
          <h1>Premium screen solutions<br /><em>for Kauaʻi homes.</em></h1>
          <p class="hero__lede">Premium screen solutions designed for Kauaʻi homes—from discreet retractable doors to wide-format motorized screens, built and installed to last.</p>
          <div class="hero__actions">
            <a class="button button--bronze" href="#contact">Get a free quote <span>↗</span></a>
            <a class="button button--glass" href={`tel:${tel}`}>
              <span class="button__icon">⌕</span><span><small>Call us today</small>{phone}</span>
            </a>
          </div>
        </div>
        <div class="container hero__foot">
          <div class="hero__trust">
            <strong>25+</strong>
            <span>Years serving<br />Kauaʻi homeowners</span>
          </div>
          <div class="hero__trust">
            <strong>5.0</strong>
            <span><b>★★★★★</b><br />Local customer rating</span>
          </div>
          <div class="hero__location">
            <span>North Shore</span><i></i><span>East Side</span><i></i><span>South Side</span>
          </div>
        </div>
      </section>

      <section class="intro section">
        <div class="container intro__grid">
          <div>
            <div class="eyebrow"><span></span> More than a screen company</div>
            <h2>Kauaʻi’s complete<br /><em>screen service company.</em></h2>
          </div>
          <div class="intro__copy">
            <p class="lead">The right screen should feel like it was designed with your home—not added after the fact.</p>
            <p>We help Kauaʻi homeowners choose, install, and maintain the right screen system—from a single window repair to a fully motorized lanai. We specify quality aluminum, proven hardware, and systems we can service down the road.</p>
            <div class="intro__details">
              <span><b>Custom fit</b>Measured on site</span>
              <span><b>Island-wide</b>We come to you</span>
              <span><b>Built to last</b>Serviceable systems</span>
            </div>
            <a class="text-link" href="#about">Why homeowners choose us <span>→</span></a>
          </div>
        </div>
      </section>

      <section class="services section" id="services">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow"><span></span> What we do</div>
              <h2>Custom screens for doors,<br /><em>windows & lanais.</em></h2>
            </div>
            <p>Custom work for doors, windows, decks, lanais, and large architectural openings across Kauaʻi.</p>
          </div>
          <div class="service-grid">
            {services.map((service) => {
              const Icon = service.icon;
              return (
                <article class="service-card">
                  <div class="service-card__top"><span>{service.num}</span><i><Icon size={20} strokeWidth={1.6} /></i></div>
                  <h3>{service.title}</h3>
                  <p>{service.copy}</p>
                  <ul>{service.tags.map((tag) => <li>{tag}</li>)}</ul>
                <a href={`/services/${service.slug}/`} aria-label={`Learn more about ${service.title}`}>Learn more <span>↗</span></a>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="feature section" id="about">
        <div class="container feature__grid">
          <div class="feature__image-wrap">
            <div class="feature__image"></div>
            <div class="feature__badge"><strong>Custom fit</strong><span>Measured & installed on site</span></div>
          </div>
          <div class="feature__content">
            <div class="eyebrow eyebrow--light"><span></span> Built around your home</div>
            <h2>Custom-fit screen installation<br /><em>built for Kauaʻi homes.</em></h2>
            <p class="lead">They should work smoothly, look intentional, and let the breeze in without competing with your view.</p>
            <p>That is why we begin with an on-site consultation. We look at the opening, traffic flow, exposure, and how you use the space—then recommend the system that makes sense. No hard sell. No one-size-fits-all shortcut.</p>
            <div class="feature__points">
              <div><strong>01</strong><span><b>Measured precisely</b>Custom fabricated for a clean fit.</span></div>
              <div><strong>02</strong><span><b>Installed professionally</b>Detailed work, respectful job sites.</span></div>
              <div><strong>03</strong><span><b>Serviceable for years</b>Quality parts we can maintain later.</span></div>
            </div>
            <a class="button button--bronze" href="#contact">Schedule a consultation <span>↗</span></a>
          </div>
        </div>
      </section>

      <section class="brands section" id="brands">
        <div class="container">
          <div class="brands__head">
            <div>
              <div class="eyebrow"><span></span> Trusted systems</div>
              <h2>Trusted retractable & motorized<br /><em>screen brands.</em></h2>
            </div>
            <p>We partner with manufacturers whose products meet our standards for performance, finish, and long-term serviceability.</p>
          </div>
          <div class="brand-list">
            {brands.map(([name, copy], index) => (
              <article class="brand-row">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{name}</h3>
                <p>{copy}</p>
                <i>↗</i>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="gallery section" id="gallery">
        <div class="container">
          <div class="section-head section-head--gallery">
            <div><div class="eyebrow"><span></span> Recent work</div><h2>Screen installations<br /><em>across Kauaʻi.</em></h2></div>
            <a class="text-link" href="#contact">Plan your project <span>→</span></a>
          </div>
          <div class="gallery__grid">
            <figure class="gallery__item gallery__item--wide">
              <div class="gallery__photo gallery__photo--one"></div>
              <figcaption><span>Motorized lanai screen</span><small>North Shore</small></figcaption>
            </figure>
            <figure class="gallery__item">
              <div class="gallery__photo gallery__photo--two"></div>
              <figcaption><span>Retractable French door</span><small>East Side</small></figcaption>
            </figure>
            <figure class="gallery__item">
              <div class="gallery__photo gallery__photo--three"></div>
              <figcaption><span>Custom window screens</span><small>South Side</small></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="reviews section" id="reviews">
        <div class="container">
          <div class="reviews__top">
            <div><div class="eyebrow eyebrow--light"><span></span> Homeowner reviews</div><h2>Kauaʻi screen installation<br /><em>& repair reviews.</em></h2></div>
            <div class="rating"><strong>5.0</strong><span><b>★★★★★</b><small>Based on local customer reviews</small></span></div>
          </div>
          <div class="review-grid">
            {reviews.map((review) => (
              <blockquote class="review-card">
                <div class="review-card__stars">★★★★★</div>
                <p>“{review.quote}”</p>
                <footer><span>{review.name.slice(0,1)}</span><div><strong>{review.name}</strong><small>{review.place}, Kauaʻi</small></div></footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <section class="area section">
        <div class="container area__grid">
          <div class="area__map" aria-label="Stylized map of Kauai">
            <svg viewBox="0 0 600 480" role="img">
              <path d="M137 76c41-25 101-38 154-26 46 10 72 37 111 51 38 14 83 8 111 43 29 36 31 90 9 131-20 37-62 53-92 80-29 27-45 67-80 86-44 24-101 11-146-8-47-19-92-48-118-92-26-45-30-102-17-152 13-48 28-88 68-113Z"></path>
              <circle cx="187" cy="105" r="7"></circle><text x="203" y="111">NORTH SHORE</text>
              <circle cx="488" cy="235" r="7"></circle><text x="384" y="220">EAST SIDE</text>
              <circle cx="350" cy="399" r="7"></circle><text x="270" y="430">SOUTH SIDE</text>
            </svg>
          </div>
          <div class="area__content">
            <div class="eyebrow"><span></span> Island-wide service</div>
            <h2>Island-wide screen service<br /><em>across Kauaʻi.</em></h2>
            <p>From Hanalei and Princeville to Kapaʻa, Līhuʻe, Kōloa, and Poʻipū, we bring experienced screen installation and repair directly to your home.</p>
            <ul>
              <li><span>North Shore</span><small>Hanalei · Princeville · Kīlauea</small></li>
              <li><span>East Side</span><small>Kapaʻa · Wailua · Līhuʻe</small></li>
              <li><span>South Side</span><small>Kōloa · Poʻipū · Kalaheo</small></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="contact section" id="contact">
        <div class="container contact__grid">
          <div class="contact__content">
            <div class="eyebrow eyebrow--light"><span></span> Start your project</div>
            <h2>Request a quote for<br /><em>your Kauaʻi screen project.</em></h2>
            <p>Tell us what you are working on. We will follow up to learn about the opening, answer your questions, and arrange a complimentary on-site consultation.</p>
            <a class="contact__phone" href={`tel:${tel}`}><span>Call us directly</span><strong>{phone}</strong></a>
            <a class="contact__email" href="mailto:info@kauairetractablescreens.com">info@kauairetractablescreens.com</a>
            <div class="contact__promise"><span>✓</span><p><b>Fast, helpful communication</b>We typically respond within one business day.</p></div>
          </div>
          <form class="quote-form" action="mailto:info@kauairetractablescreens.com" method="post" enctype="text/plain">
            <div class="quote-form__heading"><strong>Request a free quote</strong><span>No pressure. Just helpful advice.</span></div>
            <div class="quote-form__grid">
              <label><span>Full name *</span><input type="text" name="name" placeholder="Your name" required /></label>
              <label><span>Phone number *</span><input type="tel" name="phone" placeholder="(808) 000-0000" required /></label>
              <label><span>Email address *</span><input type="email" name="email" placeholder="you@email.com" required /></label>
              <label><span>Project address</span><input type="text" name="address" placeholder="Town or address" /></label>
              <label class="quote-form__full"><span>What can we help with? *</span><select name="service" required><option value="">Select a service</option><option>Retractable screen doors</option><option>Motorized screens</option><option>Window screens</option><option>Sliding screen doors</option><option>Hurricane screens</option><option>Screen repair</option><option>Not sure yet</option></select></label>
              <label class="quote-form__full"><span>Tell us about your project *</span><textarea name="description" placeholder="What opening or screen needs attention?" required></textarea></label>
              <label><span>Opening size (optional)</span><input type="text" name="measurements" placeholder="Approx. width × height" /></label>
              <label class="upload"><span>Project photos (optional)</span><input type="file" name="photos" accept="image/*" multiple /><i>＋ Add photos</i></label>
            </div>
            <button class="button button--bronze quote-form__submit" type="submit">Send quote request <span>↗</span></button>
            <small class="quote-form__note">By submitting, you agree that we may contact you about your project.</small>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__top">
          <a class="logo logo--light" href="#">
            <svg class="logo__mark" viewBox="0 0 46 46"><rect x="3" y="3" width="40" height="40" rx="2"></rect><path d="M11 33 22.7 10 35 33M15.7 24h14.5"></path></svg>
            <span class="logo__type"><strong>SCREEN PRO</strong><small>RETRACTABLE DOORS</small></span>
          </a>
          <p>Premium, custom-fit screens for the homes and lifestyles of Kauaʻi.</p>
          <a class="button button--outline" href="#contact">Get a free quote <span>↗</span></a>
        </div>
        <div class="footer__middle">
          <div><span>Explore</span><a href="#services">Services</a><a href="#brands">Brands</a><a href="#about">About</a><a href="#gallery">Gallery</a></div>
          <div><span>Services</span><a href="/services/screen-doors/">Retractable screens</a><a href="/services/motorized-screens/">Motorized screens</a><a href="/services/screen-repair/">Screen repair</a><a href="/services/hurricane-screens/">Hurricane screens</a></div>
          <div><span>Service area</span><p>Island-wide Kauaʻi<br />North Shore · East Side · South Side</p></div>
          <div><span>Contact</span><a href={`tel:${tel}`}>{phone}</a><a href="mailto:info@kauairetractablescreens.com">info@kauairetractablescreens.com</a></div>
        </div>
        <div class="footer__bottom"><span>© {new Date().getFullYear()} Screen Pro Retractable Doors</span><span>Family owned · Serving Kauaʻi since 1998</span></div>
      </div>
    </footer>
    <a class="mobile-call" href={`tel:${tel}`}>Call now <span>{phone}</span></a>

    <script is:inline data-astro-rerun>
      const button = document.querySelector(".menu-button");
      const menu = document.querySelector(".mobile-nav");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        menu?.classList.toggle("mobile-nav--open");
      });
      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        menu.classList.remove("mobile-nav--open");
        button?.setAttribute("aria-expanded", "false");
      }));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-ink: #132a37;
    --color-navy: #102f43;
    --color-navy-deep: #0a2332;
    --color-ocean: #567786;
    --color-bronze: #b98552;
    --color-bronze-light: #d7aa76;
    --color-sand: #eee7dc;
    --color-cream: #f8f6f1;
    --color-white: #fff;
    --color-line: rgba(19, 42, 55, .15);
    --font-display: "Manrope", sans-serif;
    --font-headline: Georgia, serif;
    --font-body: "DM Sans", sans-serif;
    --size-xs: .75rem;
    --size-sm: .875rem;
    --size-base: 1rem;
    --size-lg: 1.125rem;
    --space-1: .5rem;
    --space-2: .75rem;
    --space-3: 1rem;
    --space-4: 1.5rem;
    --space-5: 2rem;
    --space-6: 3rem;
    --space-7: 4.5rem;
    --space-8: 7rem;
    --radius-sm: 2px;
    --radius-md: 6px;
    --container: 1240px;
    --shadow: 0 24px 70px rgba(10, 35, 50, .13);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; color: var(--color-ink); background: var(--color-cream); font-family: var(--font-body); line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  p, h1, h2, h3 { margin-top: 0; }
  button, input, textarea, select { font: inherit; }
  .container { width: min(calc(100% - 48px), var(--container)); margin-inline: auto; }
  .section { padding: var(--space-8) 0; }
  h1, h2, h3 { font-family: var(--font-headline); }
  h1 { margin-bottom: 1.5rem; font-size: clamp(2.8rem, 5vw, 5.2rem); line-height: .94; letter-spacing: -.045em; font-weight: 400; }
  h2 { margin-bottom: 0; font-size: clamp(2.2rem, 3.7vw, 3.8rem); line-height: 1; letter-spacing: -.04em; font-weight: 400; }
  h1 em, h2 em { font-weight: 400; color: var(--color-bronze-light); font-style: italic; }
  .eyebrow { display: flex; align-items: center; margin-bottom: 1.5rem; color: var(--color-ocean); font-size: .7rem; letter-spacing: .19em; text-transform: uppercase; font-weight: 700; }
  .eyebrow > span { display: none; }
  .eyebrow--light { color: rgba(255,255,255,.7); }
  .button { min-height: 54px; padding: 0 1.5rem; display: inline-flex; align-items: center; justify-content: center; gap: 1.5rem; border: 1px solid transparent; cursor: pointer; font-size: .76rem; letter-spacing: .09em; text-transform: uppercase; font-weight: 700; transition: .25s ease; }
  .button:hover { transform: translateY(-2px); }
  .button--dark { color: white; background: var(--color-navy); }
  .button--bronze { color: white; background: var(--color-bronze); }
  .button--bronze:hover { background: #a97543; }
  .button--glass, .button--outline { color: white; border-color: rgba(255,255,255,.4); background: rgba(255,255,255,.08); }
  .button--glass { min-width: 215px; justify-content: flex-start; text-transform: none; letter-spacing: 0; }
  .button--glass small { display: block; opacity: .7; font-size: .65rem; text-transform: uppercase; letter-spacing: .1em; }
  .button__icon { font-size: 1.4rem; }
